{
  "name": "@ferrite/web",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "wasm:build:blocks": "wasm-pack build --release --target web ../blocks --out-dir ../web/src/lib/wasm/blocks -- --features wasm",
    "wasm:build:runtime": "wasm-pack build --release --target web ../runtime --out-dir ../web/src/lib/wasm/runtime --out-name runtime -- --features wasm",
    "wasm:build:fldigi": "bash ../blocks/native/fldigi/emscripten/build.sh",
    "wasm:build:whisper": "bash ../blocks/native/whisper/emscripten/build.sh",
    "wasm:build": "pnpm wasm:build:blocks && pnpm wasm:build:runtime && pnpm wasm:build:fldigi && pnpm wasm:build:whisper",
    "build": "pnpm wasm:build && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.15.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.46.1",
    "globals": "^15.14.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.2",
    "svelte": "^5.16.0",
    "svelte-check": "^4.1.1",
    "svelte-eslint-parser": "^0.43.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "bits-ui": "^2.18.0",
    "dompurify": "^3.4.2",
    "maplibre-gl": "^5.24.0",
    "marked": "^18.0.3"
  }
}
