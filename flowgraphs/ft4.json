{
  "$schema": "https://ferrite.example/flowgraph-v1.json",
  "name": "ft4",
  "label": "FT4 (HF weak-signal digital)",
  "description": "FT4 is the fast cousin of FT8 — 7.5-second slots aligned to UTC, 4-GFSK, designed for contesting where FT8's 15 s slot is too slow. Same callsign + grid + report payload, half the slot time, a few dB less weak-signal sensitivity. Waterfall signature is the FT8 tone-grid but slots tick by twice as fast. Common dial frequencies (USB demod): 3.575 / 7.0475 / 10.140 / 14.080 / 18.104 / 21.140 / 28.180 MHz. Tune slightly off the dial (DC-spike rule); the channelizer's `freq_shift_hz` recovers the carrier offset. Decoded messages stream under the `decoder::ft4` log target every 7.5 s. Audio is teed alongside so the user can listen for activity.",
  "ai_notes": "FT4 (HF weak-signal digital, 7.5 s UTC-aligned slots). Same decoder block as FT8 with `mode=ft4`. Standard dial frequencies (USB demod, listen +1500 Hz audio offset): 3.575 / 7.0475 / 10.140 / 14.080 / 18.104 / 21.140 / 28.180 MHz. Decodes appear every 7.5 s — wait ≥15 s before declaring \"no traffic.\" Output: `tail decoder --category ft4`. Switch back to FT8 via `param ft8 mode=ft8`.",
  "signal_wiki_url": "https://www.sigidwiki.com/wiki/FT4",
  "sample_path": "samples/sigidwiki/FT8_websdr_test.wav",
  "signal_wiki_image": "samples/sigidwiki/images/FT8_signal.png",
  "environments": ["node", "browser"],
  "blocks": {
    "src": {
      "type": "Source",
      "placement": "node",
      "params": {
        "center_freq_hz": 14080000.0,
        "sample_rate_hz": 2400000.0,
        "bandwidth_hz": 2000000.0
      }
    },
    "tee": {
      "type": "TeeIqF32",
      "placement": "node"
    },
    "chan": {
      "type": "Channelizer",
      "placement": "node",
      "params": {
        "input_rate_hz": 2400000.0,
        "output_rate_hz": 12000.0
      }
    },
    "fft": {
      "type": "FFT",
      "placement": "node",
      "params": {
        "size": 16384,
        "window": "hann",
        "max_frames_per_second": 30
      }
    },
    "logmag": {
      "type": "LogMagU8",
      "placement": "node",
      "params": {
        "size": 16384,
        "alpha": 0.3
      }
    },
    "demod": {
      "type": "SsbDemod",
      "placement": "node",
      "params": {
        "sample_rate_hz": 12000,
        "sideband": "usb",
        "audio_gain": 30.0
      }
    },
    "audio_tee": {
      "type": "TeeRealF32",
      "placement": "node"
    },
    "ft8": {
      "type": "Ft8Demod",
      "placement": "node",
      "params": {
        "mode": "ft4",
        "sample_rate_hz": 12000.0,
        "max_candidates": 40
      }
    },
    "audio_resamp": {
      "type": "RealF32Resamp",
      "placement": "browser",
      "when": { "audio": true },
      "params": {
        "output_rate_hz": 48000.0,
        "stopband_db": 60.0
      }
    },
    "audio_nr": {
      "type": "AudioNrMono",
      "placement": "browser",
      "when": { "audio": true },
      "params": {
        "sample_rate_hz": 48000.0,
        "neural_enable": false,
        "notch_enable": false,
        "neural_attenuation_db": 18.0
      }
    },
    "audio": {
      "type": "AudioSink",
      "placement": "browser",
      "when": { "audio": true },
      "params": {
        "buffer_samples": 8192
      }
    }
  },
  "wires": [
    ["src.out", "tee.in"],
    ["tee.out0", "chan.in"],
    ["tee.out1", "fft.in"],
    ["chan.out", "demod.in"],
    ["demod.out", "audio_tee.in"],
    ["audio_tee.out0", "ft8.in"],
    ["audio_tee.out1", "audio_resamp.in"],
    ["audio_resamp.out", "audio_nr.in"],
    ["audio_nr.out", "audio.in"],
    ["fft.out", "logmag.in"],
    ["logmag.out", "ui:fft"],
    ["ft8.events", "ui:ft8"]
  ]
}
