{
  "$schema": "https://ferrite.example/flowgraph-v1.json",
  "name": "navtex",
  "category": "Maritime",
  "label": "NAVTEX",
  "description": "NAVTEX \u2014 international maritime safety broadcast on 518 kHz (SITOR-B / CCIR-476, forward error corrected).",
  "ai_notes": "NAVTEX / SITOR-B (CCIR-476 FEC, 100 bd / 170 shift, vendored fldigi navtex core). 518 kHz international (also 490 kHz local, 4209.5 kHz). Not continuous: each station owns one 10-minute slot per 4 h, letter = slot (A = :00 after 00/04/08/12/16/20 UTC, +10 min per letter). US Pacific: Point Reyes NMC = C (00:20, 04:20, 08:20 \u2026), Long Beach/Cambria NMQ = Q (02:40, 06:40 \u2026), Astoria NMW = W (03:40, 07:40 \u2026). MF: source sample_rate 384 kHz, dial 516.5 kHz so the 518 kHz pair lands on the decoder's pinned 1500 Hz audio tone (`rx_freq_hz`); keep `afc` off \u2014 headless AFC has no spectrum to read and walks the carrier off the signal. Tune only by moving the dial; the mark/space pair must sit within \u00b1\u224850 Hz of 1500 Hz. The loop (Antenna B) hears NMQ; the longwire did not. Output: `tail decoder --category fldigi`.",
  "signal_wiki_url": "https://www.sigidwiki.com/wiki/NAVTEX",
  "sample_path": "samples/sigidwiki/NAVTEX_SITOR-B.mp3",
  "signal_wiki_image": "samples/sigidwiki/images/NAVTEX.jpg",
  "environments": [
    "node",
    "browser"
  ],
  "blocks": {
    "src": {
      "type": "Source",
      "placement": "node",
      "params": {
        "center_freq_hz": 516500.0,
        "sample_rate_hz": 384000.0,
        "bandwidth_hz": 300000.0
      }
    },
    "tee": {
      "type": "TeeIqF32",
      "placement": "node"
    },
    "chan": {
      "type": "Channelizer",
      "placement": "node",
      "params": {
        "input_rate_hz": 384000.0,
        "output_rate_hz": 8000.0
      }
    },
    "fft": {
      "type": "FFT",
      "placement": "node",
      "params": {
        "size": 16384,
        "window": "hann",
        "max_frames_per_second": 30
      }
    },
    "logmag": {
      "type": "LogMagU8",
      "placement": "node",
      "params": {
        "size": 16384,
        "alpha": 0.3
      }
    },
    "demod": {
      "type": "SsbDemod",
      "placement": "node",
      "params": {
        "sample_rate_hz": 8000,
        "sideband": "usb",
        "audio_gain": 30.0
      }
    },
    "audio_tee": {
      "type": "TeeRealF32",
      "placement": "node"
    },
    "audio_resamp": {
      "type": "RealF32Resamp",
      "placement_role": "audio",
      "placement": "browser",
      "when": {
        "audio": true
      },
      "params": {
        "output_rate_hz": 48000.0,
        "stopband_db": 60.0
      }
    },
    "audio_nr": {
      "type": "AudioNrMono",
      "placement_role": "nr",
      "placement": "browser",
      "when": {
        "audio": true
      },
      "params": {
        "sample_rate_hz": 48000.0,
        "neural_enable": false,
        "notch_enable": false,
        "neural_attenuation_db": 18.0
      }
    },
    "audio": {
      "type": "AudioSink",
      "placement": "browser",
      "when": {
        "audio": true
      },
      "params": {
        "buffer_samples": 8192
      }
    },
    "navtex": {
      "type": "NavtexDemod",
      "placement": "node",
      "params": {
        "afc": false,
        "rx_freq_hz": 1500.0
      }
    }
  },
  "wires": [
    [
      "src.out",
      "tee.in"
    ],
    [
      "tee.out0",
      "chan.in"
    ],
    [
      "tee.out1",
      "fft.in"
    ],
    [
      "chan.out",
      "demod.in"
    ],
    [
      "demod.out",
      "audio_tee.in"
    ],
    [
      "audio_tee.out0",
      "navtex.in"
    ],
    [
      "audio_tee.out1",
      "audio_resamp.in"
    ],
    [
      "audio_resamp.out",
      "audio_nr.in"
    ],
    [
      "audio_nr.out",
      "audio.in"
    ],
    [
      "fft.out",
      "logmag.in"
    ],
    [
      "navtex.events",
      "ui:fldigi"
    ],
    [
      "logmag.out",
      "ui:fft"
    ]
  ]
}
