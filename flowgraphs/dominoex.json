{
  "$schema": "https://ferrite.example/flowgraph-v1.json",
  "name": "dominoex",
  "label": "DominoEX (incremental MFSK)",
  "description": "DominoEX is an incremental-frequency-keying MFSK mode (IFK+) \u2014 robust against multipath and tuning error, popular for HF NVIS and weak-signal chat. DominoEX 16 is a common amateur variant (~16 baud, ~316 Hz wide). On the waterfall it's a lively staircase of tones. Decoded text streams under decoder::fldigi (vendored fldigi dominoex core). DominoEX is forgiving of mistuning; get the signal roughly into the USB passband and it locks.",
  "ai_notes": "DominoEX (incremental MFSK / IFK+, vendored fldigi dominoex core). dominoex16 default; variants via FldigiDemod mode: dominoex4/8/11/16/22/44. Activity ~14.070\u201314.078 MHz and on NVIS nets. Tune dial \u2248 signal \u2212 1500 Hz; tolerant of mistuning. Output: `tail decoder --category fldigi`.",
  "signal_wiki_url": "https://www.sigidwiki.com/wiki/DominoEX",
  "sample_path": "samples/sigidwiki/DominoEX_16Bd.mp3",
  "signal_wiki_image": "samples/sigidwiki/images/DominoEX.png",
  "environments": [
    "node",
    "browser"
  ],
  "blocks": {
    "src": {
      "type": "Source",
      "placement": "node",
      "params": {
        "center_freq_hz": 14075500.0,
        "sample_rate_hz": 2400000.0,
        "bandwidth_hz": 2000000.0
      }
    },
    "tee": {
      "type": "TeeIqF32",
      "placement": "node"
    },
    "chan": {
      "type": "Channelizer",
      "placement": "node",
      "params": {
        "input_rate_hz": 2400000.0,
        "output_rate_hz": 8000.0
      }
    },
    "fft": {
      "type": "FFT",
      "placement": "node",
      "params": {
        "size": 16384,
        "window": "hann",
        "max_frames_per_second": 30
      }
    },
    "logmag": {
      "type": "LogMagU8",
      "placement": "node",
      "params": {
        "size": 16384,
        "alpha": 0.3
      }
    },
    "demod": {
      "type": "SsbDemod",
      "placement": "node",
      "params": {
        "sample_rate_hz": 8000,
        "sideband": "usb",
        "audio_gain": 30.0
      }
    },
    "audio_tee": {
      "type": "TeeRealF32",
      "placement": "node"
    },
    "audio_resamp": {
      "type": "RealF32Resamp",
      "placement": "browser",
      "when": {
        "audio": true
      },
      "params": {
        "output_rate_hz": 48000.0,
        "stopband_db": 60.0
      }
    },
    "audio_nr": {
      "type": "AudioNrMono",
      "placement": "browser",
      "when": {
        "audio": true
      },
      "params": {
        "sample_rate_hz": 48000.0,
        "neural_enable": false,
        "notch_enable": false,
        "neural_attenuation_db": 18.0
      }
    },
    "audio": {
      "type": "AudioSink",
      "placement": "browser",
      "when": {
        "audio": true
      },
      "params": {
        "buffer_samples": 8192
      }
    },
    "dominoex": {
      "type": "FldigiDemod",
      "placement": "node",
      "params": {
        "mode": "dominoex16",
        "sample_rate_hz": 8000.0,
        "afc": true
      }
    }
  },
  "wires": [
    [
      "src.out",
      "tee.in"
    ],
    [
      "tee.out0",
      "chan.in"
    ],
    [
      "tee.out1",
      "fft.in"
    ],
    [
      "chan.out",
      "demod.in"
    ],
    [
      "demod.out",
      "audio_tee.in"
    ],
    [
      "audio_tee.out0",
      "dominoex.in"
    ],
    [
      "audio_tee.out1",
      "audio_resamp.in"
    ],
    [
      "audio_resamp.out",
      "audio_nr.in"
    ],
    [
      "audio_nr.out",
      "audio.in"
    ],
    [
      "fft.out",
      "logmag.in"
    ],
    [
      "logmag.out",
      "ui:fft"
    ]
  ]
}