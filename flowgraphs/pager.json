{
  "$schema": "https://ferrite.example/flowgraph-v1.json",
  "name": "pager",
  "label": "Pagers (POCSAG / FLEX)",
  "description": "Pager messages on the 929–932 MHz US carrier band — POCSAG (512/1200/2400 bps) and FLEX (1600/3200/6400 bps 4-FSK) in parallel.",
  "signal_wiki_url": "https://www.sigidwiki.com/wiki/POCSAG",
  "sample_path": "samples/sigidwiki/POCSAG_Sound.mp3",
  "signal_wiki_image": "samples/sigidwiki/images/POCSAG_Waterfallthmb.png",
  "environments": [
    "node",
    "browser"
  ],
  "blocks": {
    "src": {
      "type": "Source",
      "placement": "node",
      "params": {
        "sample_rate_hz": 2400000.0,
        "bandwidth_hz": 2000000.0
      }
    },
    "chan": {
      "type": "Channelizer",
      "placement": "node",
      "params": {
        "input_rate_hz": 2400000.0,
        "output_rate_hz": 25000.0
      }
    },
    "tee": {
      "type": "TeeIqF32",
      "placement": "node"
    },
    "fft": {
      "type": "FFT",
      "placement": "node",
      "params": {
        "size": 16384,
        "window": "hann",
        "max_frames_per_second": 30
      }
    },
    "logmag": {
      "type": "LogMagU8",
      "placement": "node",
      "params": {
        "size": 16384,
        "alpha": 0.3
      }
    },
    "demod": {
      "type": "FmDemod",
      "placement": "node",
      "params": {
        "sample_rate_hz": 25000,
        "max_deviation_hz": 5000
      }
    },
    "resamp": {
      "type": "RealF32Resamp",
      "placement": "node",
      "params": {
        "output_rate_hz": 22050.0,
        "stopband_db": 60.0
      }
    },
    "pager": {
      "type": "PagerDemod",
      "placement": "node",
      "params": {
        "sample_rate_hz": 22050.0
      }
    }
  },
  "wires": [
    [
      "src.out",
      "tee.in"
    ],
    [
      "tee.out0",
      "chan.in"
    ],
    [
      "tee.out1",
      "fft.in"
    ],
    [
      "chan.out",
      "demod.in"
    ],
    [
      "fft.out",
      "logmag.in"
    ],
    [
      "logmag.out",
      "ui:fft"
    ],
    [
      "demod.out",
      "resamp.in"
    ],
    [
      "resamp.out",
      "pager.in"
    ]
  ]
}
