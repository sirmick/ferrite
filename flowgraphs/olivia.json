{
  "$schema": "https://ferrite.example/flowgraph-v1.json",
  "name": "olivia",
  "category": "HF digital modes",
  "label": "Olivia",
  "description": "Olivia \u2014 very robust weak-signal MFSK with strong FEC; readable well below the noise floor where RTTY/PSK fail.",
  "ai_notes": "Olivia 8/500 (8-tone MFSK + FEC, vendored fldigi olivia core, Ja\u0142ocha engine). Variants via OliviaDemod mode: olivia, olivia-8-500, olivia-16-500, olivia-32-1000. Very mistuning-tolerant; tune dial \u2248 signal \u2212 1500 Hz. Multi-second decode latency by design (FEC interleaver). Calling freqs ~14.0729 / 7.0729 / 10.142 MHz + nets. Output: `tail decoder --category fldigi`.",
  "signal_wiki_url": "https://www.sigidwiki.com/wiki/Olivia",
  "sample_path": "samples/sigidwiki/Olivia_8-500.mp3",
  "signal_wiki_image": "samples/sigidwiki/images/Olivia_8-500.jpg",
  "environments": [
    "node",
    "browser"
  ],
  "variants": [
    {
      "id": "8-500",
      "label": "8/500",
      "default": true,
      "patch": {}
    },
    {
      "id": "16-500",
      "label": "16/500",
      "patch": {
        "olivia": {
          "tones": 16,
          "bandwidth": 500
        }
      }
    },
    {
      "id": "32-1000",
      "label": "32/1000",
      "patch": {
        "olivia": {
          "tones": 32,
          "bandwidth": 1000
        }
      }
    }
  ],
  "blocks": {
    "src": {
      "type": "Source",
      "placement": "node",
      "params": {
        "center_freq_hz": 14071400.0,
        "sample_rate_hz": 2400000.0,
        "bandwidth_hz": 2000000.0
      }
    },
    "tee": {
      "type": "TeeIqF32",
      "placement": "node"
    },
    "chan": {
      "type": "Channelizer",
      "placement": "node",
      "params": {
        "input_rate_hz": 2400000.0,
        "output_rate_hz": 8000.0
      }
    },
    "fft": {
      "type": "FFT",
      "placement": "node",
      "params": {
        "size": 16384,
        "window": "hann",
        "max_frames_per_second": 30
      }
    },
    "logmag": {
      "type": "LogMagU8",
      "placement": "node",
      "params": {
        "size": 16384,
        "alpha": 0.3
      }
    },
    "demod": {
      "type": "SsbDemod",
      "placement": "node",
      "params": {
        "sample_rate_hz": 8000,
        "sideband": "usb",
        "audio_gain": 30.0
      }
    },
    "audio_tee": {
      "type": "TeeRealF32",
      "placement": "node"
    },
    "audio_resamp": {
      "type": "RealF32Resamp",
      "placement": "browser",
      "when": {
        "audio": true
      },
      "params": {
        "output_rate_hz": 48000.0,
        "stopband_db": 60.0
      }
    },
    "audio_nr": {
      "type": "AudioNrMono",
      "placement": "browser",
      "when": {
        "audio": true
      },
      "params": {
        "sample_rate_hz": 48000.0,
        "neural_enable": false,
        "notch_enable": false,
        "neural_attenuation_db": 18.0
      }
    },
    "audio": {
      "type": "AudioSink",
      "placement": "browser",
      "when": {
        "audio": true
      },
      "params": {
        "buffer_samples": 8192
      }
    },
    "olivia": {
      "type": "OliviaDemod",
      "placement": "node",
      "params": {
        "afc": true
      }
    }
  },
  "wires": [
    [
      "src.out",
      "tee.in"
    ],
    [
      "tee.out0",
      "chan.in"
    ],
    [
      "tee.out1",
      "fft.in"
    ],
    [
      "chan.out",
      "demod.in"
    ],
    [
      "demod.out",
      "audio_tee.in"
    ],
    [
      "audio_tee.out0",
      "olivia.in"
    ],
    [
      "audio_tee.out1",
      "audio_resamp.in"
    ],
    [
      "audio_resamp.out",
      "audio_nr.in"
    ],
    [
      "audio_nr.out",
      "audio.in"
    ],
    [
      "fft.out",
      "logmag.in"
    ],
    [
      "olivia.events",
      "ui:fldigi"
    ],
    [
      "logmag.out",
      "ui:fft"
    ]
  ]
}
