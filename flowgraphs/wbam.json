{
  "$schema": "https://ferrite.example/flowgraph-v1.json",
  "name": "wbam",
  "label": "AM broadcast",
  "description": "AM broadcast \u2014 medium wave (540\u20131700 kHz), shortwave, and aviation (118\u2013137 MHz). Coherent demod via liquid-dsp ampmodem.",
  "ai_notes": "AM broadcast + shortwave SWL + aviation AM. Pins `agc_enable=false` via force_params to dodge envelope-pumping on sustained voice. Full audio_nr stack on by default (blanker + notch + spectral mmse_lsa@1.8x + neural@18dB) \u2014 AM picks up everything, the stack earns its keep. On SDRplay, best with the HF antenna port (see driver notes).",
  "signal_wiki_url": "https://www.sigidwiki.com/wiki/Amplitude_Modulation_(AM)",
  "sample_path": "samples/sigidwiki/AM_Sound.mp3",
  "signal_wiki_image": "samples/sigidwiki/images/AM_Waterfall.jpg",
  "environments": ["node", "browser"],
  "blocks": {
    "src": {
      "type": "Source",
      "placement": "node",
      "params": {
        "sample_rate_hz": 2400000.0,
        "bandwidth_hz": 2000000.0
      },
      "force_params": {
        "agc_enable": false
      }
    },
    "chan": {
      "type": "Channelizer",
      "placement": "node",
      "params": {
        "input_rate_hz": 2400000.0,
        "output_rate_hz": 12000.0
      }
    },
    "tee": {
      "type": "TeeIqF32",
      "placement": "node"
    },
    "fft": {
      "type": "FFT",
      "placement": "node",
      "params": {
        "size": 16384,
        "window": "hann",
        "max_frames_per_second": 30
      }
    },
    "logmag": {
      "type": "LogMagU8",
      "placement": "node",
      "params": {
        "size": 16384,
        "floor_dbfs": -100.0,
        "ceil_dbfs": 0.0,
        "alpha": 0.3
      }
    },
    "demod": {
      "type": "AmDemod",
      "placement": "browser",
      "params": {
        "sample_rate_hz": 12000,
        "audio_gain": 80.0
      }
    },
    "audio": {
      "type": "AudioSink",
      "params": {
        "buffer_samples": 8192
      }
    },
    "resamp": {
      "type": "RealF32Resamp",
      "placement": "browser",
      "params": {
        "output_rate_hz": 48000.0,
        "stopband_db": 60.0
      }
    },
    "audio_nr": {
      "type": "AudioNrMono",
      "placement": "browser",
      "params": {
        "sample_rate_hz": 48000.0,
        "blanker_enable": true,
        "blanker_threshold_db": 18.0,
        "blanker_hold_ms": 0.5,
        "notch_enable": true,
        "notch_taps": 64,
        "notch_mu": 0.01,
        "notch_delay": 2,
        "spectral_enable": true,
        "spectral_method": "mmse_lsa",
        "spectral_block_size": 512,
        "spectral_oversub": 1.8,
        "spectral_floor": 0.1,
        "neural_enable": true,
        "neural_attenuation_db": 18.0
      }
    }
  },
  "wires": [
    ["src.out", "tee.in"],
    ["tee.out0", "chan.in"],
    ["tee.out1", "fft.in"],
    ["chan.out", "demod.in"],
    ["fft.out", "logmag.in"],
    ["logmag.out", "ui:fft"],
    ["demod.out", "resamp.in"],
    ["resamp.out", "audio_nr.in"],
    ["audio_nr.out", "audio.in"]
  ]
}
