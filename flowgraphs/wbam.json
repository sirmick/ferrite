{
  "$schema": "https://ferrite.example/flowgraph-v1.json",
  "name": "wbam",
  "label": "AM broadcast",
  "description": "AM broadcast — medium wave (540–1700 kHz), shortwave, and aviation (118–137 MHz, AM mode). Envelope demodulation with carrier-derived gain. Tune to a strong station first to verify your antenna is in the right band.",
  "environments": [
    "node",
    "browser"
  ],
  "blocks": {
    "src": {
      "type": "Source",
      "placement": "node",
      "params": {
        "center_freq_hz": 100100000.0,
        "sample_rate_hz": 2400000.0,
        "bandwidth_hz": 2000000.0
      }
    },
    "chan": {
      "type": "Channelizer",
      "placement": "node",
      "params": {
        "input_rate_hz": 2400000.0,
        "freq_shift_hz": 0.0,
        "output_rate_hz": 24000.0
      }
    },
    "tee": {
      "type": "TeeIqF32",
      "placement": "node"
    },
    "fft": {
      "type": "FFT",
      "placement": "node",
      "params": {
        "size": 16384,
        "window": "hann",
        "max_frames_per_second": 30
      }
    },
    "logmag": {
      "type": "LogMagU8",
      "placement": "node",
      "params": {
        "size": 16384,
        "floor_dbfs": -100.0,
        "ceil_dbfs": 0.0,
        "alpha": 0.3
      }
    },
    "demod": {
      "type": "AmDemod",
      "placement": "browser",
      "params": {
        "sample_rate_hz": 48000,
        "audio_gain": 20.0
      }
    },
    "audio": {
      "type": "AudioSink",
      "params": {
        "buffer_samples": 8192
      }
    },
    "resamp": {
      "type": "RealF32Resamp",
      "placement": "browser",
      "params": {
        "output_rate_hz": 48000.0,
        "stopband_db": 60.0
      }
    }
  },
  "wires": [
    [
      "src.out",
      "tee.in"
    ],
    [
      "tee.out0",
      "chan.in"
    ],
    [
      "tee.out1",
      "fft.in"
    ],
    [
      "chan.out",
      "demod.in"
    ],
    [
      "fft.out",
      "logmag.in"
    ],
    [
      "logmag.out",
      "ui:fft"
    ],
    [
      "demod.out",
      "resamp.in"
    ],
    [
      "resamp.out",
      "audio.in"
    ]
  ]
}
