{
  "$schema": "https://ferrite.example/flowgraph-v1.json",
  "name": "wbam",
  "label": "AM broadcast",
  "description": "Wideband AM receiver authored as one cross-env doc. Structurally a mirror of wbfm.json — TeeIqF32 fans the raw 2.4 MS/s source into a server-side FFT → LogMagU8 → ui:fft tap (full-RF view) and an audio chain where a Channelizer picks the listening frequency, a 5× decim brings it to 48 kHz, and an envelope-detector AM demod with a 100 ms DC-blocker feeds the AudioSink. The source block params match wbfm.json so a receivers-pane toggle can swap just the demod chain.",
  "environments": ["node", "browser"],
  "blocks": {
    "src": {
      "type": "Source",
      "placement": "node",
      "params": {
        "center_freq_hz": 100100000.0,
        "sample_rate_hz": 2400000.0,
        "bandwidth_hz": 2000000.0
      }
    },
    "chan": {
      "type": "Channelizer",
      "placement": "node",
      "params": {
        "input_rate_hz": 2400000.0,
        "freq_shift_hz": 0.0,
        "factor": 10,
        "num_taps": 81,
        "cutoff_normalized": 0.03125
      }
    },
    "tee": {
      "type": "TeeIqF32",
      "placement": "node"
    },
    "fft": {
      "type": "FFT",
      "placement": "node",
      "params": {
        "size": 16384,
        "window": "hann"
      }
    },
    "logmag": {
      "type": "LogMagU8",
      "placement": "node",
      "params": {
        "size": 16384,
        "floor_dbfs": -100.0,
        "ceil_dbfs": 0.0,
        "alpha": 0.3
      }
    },
    "decim": {
      "type": "Decimator",
      "placement": "browser",
      "params": {
        "factor": 5,
        "num_taps": 41,
        "cutoff_normalized": 0.08
      }
    },
    "demod": {
      "type": "AmDemod",
      "placement": "browser",
      "params": {
        "sample_rate_hz": 48000,
        "bias_tau_ms": 100
      }
    },
    "audio": {
      "type": "AudioSink",
      "params": {
        "buffer_samples": 8192
      }
    }
  },
  "wires": [
    ["src.out", "tee.in"],
    ["tee.out0", "chan.in"],
    ["tee.out1", "fft.in"],
    ["chan.out", "decim.in"],
    ["fft.out", "logmag.in"],
    ["logmag.out", "ui:fft"],
    ["decim.out", "demod.in"],
    ["demod.out", "audio.in"]
  ]
}
