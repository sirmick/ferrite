{
  "$schema": "https://ferrite.example/flowgraph-v1.json",
  "name": "wbam",
  "category": "FM/AM broadcast",
  "label": "AM broadcast",
  "description": "AM broadcast \u2014 medium-wave (540\u20131700 kHz), shortwave, and aviation AM (118\u2013137 MHz). Envelope demodulation.",
  "ai_notes": "AM broadcast + shortwave SWL + aviation AM. Envelope detector, 5 kHz audio LPF. Hardware `agc` is force-pinned off (AM is amplitude-carried; hardware AGC fights the modulation). Audio NR: `blanker` + `agc`; `notch`/`spectral`/`neural` selectable in the UI for hissy bands or heterodynes. On SDRplay use the HF antenna port (see driver notes).",
  "signal_wiki_url": "https://www.sigidwiki.com/wiki/Amplitude_Modulation_(AM)",
  "sample_path": "samples/sigidwiki/AM_Sound.mp3",
  "signal_wiki_image": "samples/sigidwiki/images/AM_Waterfall.jpg",
  "environments": [
    "node",
    "browser"
  ],
  "blocks": {
    "src": {
      "type": "Source",
      "placement": "node",
      "params": {
        "sample_rate_hz": 2400000.0,
        "bandwidth_hz": 2000000.0
      },
      "force_params": {
        "agc": false
      }
    },
    "chan": {
      "type": "Channelizer",
      "placement": "node",
      "params": {
        "input_rate_hz": 2400000.0,
        "output_rate_hz": 12000.0
      }
    },
    "tee": {
      "type": "TeeIqF32",
      "placement": "node"
    },
    "fft": {
      "type": "FFT",
      "placement": "node",
      "params": {
        "size": 16384,
        "window": "hann",
        "max_frames_per_second": 30
      }
    },
    "logmag": {
      "type": "LogMagU8",
      "placement": "node",
      "params": {
        "size": 16384,
        "floor_dbfs": -100.0,
        "ceil_dbfs": 0.0,
        "alpha": 0.3
      }
    },
    "demod": {
      "type": "AmDemod",
      "placement": "browser",
      "placement_role": "demod",
      "params": {
        "sample_rate_hz": 12000,
        "audio_gain": 80.0
      }
    },
    "audio": {
      "type": "AudioSink",
      "placement": "browser",
      "when": {
        "audio": true
      },
      "params": {
        "buffer_samples": 8192
      }
    },
    "shaper": {
      "type": "AudioShaper",
      "placement": "browser",
      "when": {
        "audio": true
      },
      "params": {
        "sample_rate_hz": 12000.0,
        "lpf_hz": 5000.0,
        "dc_block": false
      }
    },
    "resamp": {
      "type": "RealF32Resamp",
      "placement": "browser",
      "when": {
        "audio": true
      },
      "params": {
        "output_rate_hz": 48000.0,
        "stopband_db": 60.0
      }
    },
    "audio_nr": {
      "type": "AudioNrMono",
      "placement": "browser",
      "when": {
        "audio": true
      },
      "params": {
        "sample_rate_hz": 48000.0,
        "blanker_enable": true,
        "blanker_threshold_db": 18.0,
        "blanker_hold_ms": 0.5,
        "agc_enable": true,
        "agc_target_dbfs": -6.0,
        "agc_release_ms": 500.0,
        "agc_max_gain_db": 20.0
      }
    }
  },
  "wires": [
    [
      "src.out",
      "tee.in"
    ],
    [
      "tee.out0",
      "chan.in"
    ],
    [
      "tee.out1",
      "fft.in"
    ],
    [
      "chan.out",
      "demod.in"
    ],
    [
      "fft.out",
      "logmag.in"
    ],
    [
      "logmag.out",
      "ui:fft"
    ],
    [
      "demod.out",
      "shaper.in"
    ],
    [
      "shaper.out",
      "resamp.in"
    ],
    [
      "resamp.out",
      "audio_nr.in"
    ],
    [
      "audio_nr.out",
      "audio.in"
    ]
  ]
}
