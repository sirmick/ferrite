{
  "$schema": "https://ferrite.example/flowgraph-v1.json",
  "name": "aprs",
  "label": "APRS / packet (144.39 MHz)",
  "description": "APRS / amateur packet radio on 144.39 MHz US (144.800 EU). Five multimon decoders in parallel: AFSK1200, AFSK2400 \u00d73, FSK9600 G3RUH.",
  "ai_notes": "APRS / packet on 144.39 MHz (NA), 144.800 MHz (EU), 145.175 MHz (AU). Five multimon decoders run in parallel (AFSK1200, AFSK2400 \u00d73, FSK9600) so you don't need to pick a variant manually. Output: `tail decoder --category packet`. For diagnostic side-by-side with a WAV recording see `aprs-debug`.",
  "signal_wiki_url": "https://www.sigidwiki.com/wiki/Automatic_Packet_Reporting_System_(APRS)",
  "sample_path": "samples/sigidwiki/AFSK1200_Sound.mp3",
  "signal_wiki_image": "samples/sigidwiki/images/AFSK1200_Waterfall.png",
  "environments": ["node", "browser"],
  "blocks": {
    "src": {
      "type": "Source",
      "placement": "node",
      "params": {
        "sample_rate_hz": 2400000.0,
        "bandwidth_hz": 2000000.0
      }
    },
    "chan": {
      "type": "Channelizer",
      "placement": "node",
      "params": {
        "input_rate_hz": 2400000.0,
        "output_rate_hz": 25000.0
      }
    },
    "tee": {
      "type": "TeeIqF32",
      "placement": "node"
    },
    "fft": {
      "type": "FFT",
      "placement": "node",
      "params": {
        "size": 16384,
        "window": "hann",
        "max_frames_per_second": 30
      }
    },
    "logmag": {
      "type": "LogMagU8",
      "placement": "node",
      "params": {
        "size": 16384,
        "alpha": 0.3
      }
    },
    "demod": {
      "type": "FmDemod",
      "placement": "node",
      "placement_role": "demod",
      "params": {
        "sample_rate_hz": 25000,
        "max_deviation_hz": 5000
      }
    },
    "audio_tee": {
      "type": "TeeRealF32",
      "placement": "node"
    },
    "resamp": {
      "type": "RealF32Resamp",
      "placement": "node",
      "params": {
        "output_rate_hz": 22050.0,
        "stopband_db": 60.0
      }
    },
    "packet": {
      "type": "PacketDemod",
      "placement": "node",
      "params": {
        "sample_rate_hz": 22050.0
      }
    },
    "audio_resamp": {
      "type": "RealF32Resamp",
      "placement": "browser",
      "when": { "audio": true },
      "params": {
        "output_rate_hz": 48000.0,
        "stopband_db": 60.0
      }
    },
    "audio": {
      "type": "AudioSink",
      "placement": "browser",
      "when": { "audio": true },
      "params": {
        "buffer_samples": 8192
      }
    }
  },
  "wires": [
    ["src.out", "tee.in"],
    ["tee.out0", "chan.in"],
    ["tee.out1", "fft.in"],
    ["chan.out", "demod.in"],
    ["fft.out", "logmag.in"],
    ["logmag.out", "ui:fft"],
    ["demod.out", "audio_tee.in"],
    ["audio_tee.out0", "resamp.in"],
    ["resamp.out", "packet.in"],
    ["audio_tee.out1", "audio_resamp.in"],
    ["audio_resamp.out", "audio.in"]
  ]
}
