{
  "$schema": "https://ferrite.example/flowgraph-v1.json",
  "name": "aprs",
  "label": "APRS / packet (144.39 MHz)",
  "description": "Decode APRS and amateur packet radio (AFSK1200, AFSK2400 ×3 timing variants, FSK9600 G3RUH) on the 144.39 MHz US APRS channel — runs all five multimon-ng demodulators in parallel on the same NBFM-demodulated audio. Decoded frames stream into the Logs tab under the `decoder::packet` category. Tune to 144.800 MHz for European APRS, or wherever your local digipeaters live; FSK9600 catches amateur-satellite passes (PSAT, AISAT-1).",
  "signal_wiki_url": "https://www.sigidwiki.com/wiki/Automatic_Packet_Reporting_System_(APRS)",
  "sample_path": "samples/sigidwiki/AFSK1200_Sound.mp3",
  "environments": [
    "node",
    "browser"
  ],
  "blocks": {
    "src": {
      "type": "Source",
      "placement": "node",
      "params": {
        "center_freq_hz": 144390000.0,
        "sample_rate_hz": 2400000.0,
        "bandwidth_hz": 2000000.0
      }
    },
    "chan": {
      "type": "Channelizer",
      "placement": "node",
      "params": {
        "input_rate_hz": 2400000.0,
        "freq_shift_hz": 0.0,
        "output_rate_hz": 50000.0
      }
    },
    "tee": {
      "type": "TeeIqF32",
      "placement": "node"
    },
    "fft": {
      "type": "FFT",
      "placement": "node",
      "params": {
        "size": 16384,
        "window": "hann",
        "max_frames_per_second": 30
      }
    },
    "logmag": {
      "type": "LogMagU8",
      "placement": "node",
      "params": {
        "size": 16384,
        "alpha": 0.3
      }
    },
    "demod": {
      "type": "FmDemod",
      "placement": "node",
      "params": {
        "sample_rate_hz": 50000,
        "max_deviation_hz": 5000
      }
    },
    "resamp": {
      "type": "RealF32Resamp",
      "placement": "node",
      "params": {
        "output_rate_hz": 22050.0,
        "stopband_db": 60.0
      }
    },
    "packet": {
      "type": "PacketDemod",
      "placement": "node",
      "params": {
        "sample_rate_hz": 22050.0
      }
    }
  },
  "wires": [
    [
      "src.out",
      "tee.in"
    ],
    [
      "tee.out0",
      "chan.in"
    ],
    [
      "tee.out1",
      "fft.in"
    ],
    [
      "chan.out",
      "demod.in"
    ],
    [
      "fft.out",
      "logmag.in"
    ],
    [
      "logmag.out",
      "ui:fft"
    ],
    [
      "demod.out",
      "resamp.in"
    ],
    [
      "resamp.out",
      "packet.in"
    ]
  ]
}
