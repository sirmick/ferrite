{
  "$schema": "https://ferrite.example/flowgraph-v1.json",
  "name": "ais",
  "category": "Maritime",
  "label": "AIS (marine)",
  "description": "Marine AIS Class A/B vessel transponders on the two AIS channels (161.975 / 162.025 MHz).",
  "ai_notes": "Marine AIS Class A/B vessel transponders on AIS-1 (161.975 MHz) + AIS-2 (162.025 MHz). Centred at 162.000 MHz so both channels fall inside one channelized slice. Best near coastlines or major shipping lanes. Output: `tail decoder --category ais` \u2014 MMSI / position / course / vessel type.",
  "signal_wiki_url": "https://www.sigidwiki.com/wiki/Automatic_Identification_System_(AIS)",
  "sample_path": "samples/sigidwiki/AIS_IQ_5s.wav",
  "signal_wiki_image": "samples/sigidwiki/images/AIS_Waterfall.jpg",
  "environments": [
    "node",
    "browser"
  ],
  "blocks": {
    "src": {
      "type": "Source",
      "placement": "node",
      "params": {
        "sample_rate_hz": 2000000.0,
        "bandwidth_hz": 200000.0
      }
    },
    "tee_main": {
      "type": "TeeIqF32",
      "placement": "node"
    },
    "tee_chans": {
      "type": "TeeIqF32",
      "placement": "node"
    },
    "fft": {
      "type": "FFT",
      "placement": "node",
      "params": {
        "size": 16384,
        "window": "hann",
        "max_frames_per_second": 30
      }
    },
    "logmag": {
      "type": "LogMagU8",
      "placement": "node",
      "params": {
        "size": 16384,
        "alpha": 0.3
      }
    },
    "chan_a": {
      "type": "Channelizer",
      "placement": "node",
      "params": {
        "input_rate_hz": 2000000.0,
        "freq_shift_hz": -25000.0,
        "output_rate_hz": 25000.0
      }
    },
    "chan_b": {
      "type": "Channelizer",
      "placement": "node",
      "params": {
        "input_rate_hz": 2000000.0,
        "freq_shift_hz": 25000.0,
        "output_rate_hz": 25000.0
      }
    },
    "fm_a": {
      "type": "FmDemod",
      "placement": "node",
      "params": {
        "sample_rate_hz": 25000,
        "max_deviation_hz": 5000
      }
    },
    "fm_b": {
      "type": "FmDemod",
      "placement": "node",
      "params": {
        "sample_rate_hz": 25000,
        "max_deviation_hz": 5000
      }
    },
    "resamp_a": {
      "type": "RealF32Resamp",
      "placement_role": "audio",
      "placement": "node",
      "params": {
        "output_rate_hz": 48000.0,
        "stopband_db": 60.0
      }
    },
    "resamp_b": {
      "type": "RealF32Resamp",
      "placement_role": "audio",
      "placement": "node",
      "params": {
        "output_rate_hz": 48000.0,
        "stopband_db": 60.0
      }
    },
    "ais": {
      "type": "AisDemod",
      "placement": "node",
      "params": {
        "sample_rate_hz": 48000.0
      }
    }
  },
  "wires": [
    [
      "src.out",
      "tee_main.in"
    ],
    [
      "tee_main.out0",
      "tee_chans.in"
    ],
    [
      "tee_main.out1",
      "fft.in"
    ],
    [
      "tee_chans.out0",
      "chan_a.in"
    ],
    [
      "tee_chans.out1",
      "chan_b.in"
    ],
    [
      "chan_a.out",
      "fm_a.in"
    ],
    [
      "chan_b.out",
      "fm_b.in"
    ],
    [
      "fm_a.out",
      "resamp_a.in"
    ],
    [
      "fm_b.out",
      "resamp_b.in"
    ],
    [
      "resamp_a.out",
      "ais.ch_a"
    ],
    [
      "resamp_b.out",
      "ais.ch_b"
    ],
    [
      "fft.out",
      "logmag.in"
    ],
    [
      "logmag.out",
      "ui:fft"
    ],
    [
      "ais.events",
      "ui:ais"
    ]
  ]
}
