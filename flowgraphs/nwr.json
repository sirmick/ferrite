{
  "$schema": "https://ferrite.example/flowgraph-v1.json",
  "name": "nwr",
  "label": "NOAA Weather Radio + EAS (162.55 MHz)",
  "description": "Listen for SAME / EAS headers on a NOAA Weather Radio (NWR) channel. Default tuning is 162.550 MHz, the strongest of the seven NWR allocations in many US metros — try 162.400 / .425 / .450 / .475 / .500 / .525 / .550 if reception is weak. The NBFM audio is demodulated, resampled to multimon's native 22050 Hz, and fed to `EasDemod`; decoded headers (alert kind, FIPS county codes, duration) appear in the Logs tab under `decoder::eas`. To actually listen to the audio, swap to the `nbfm` preset on the same frequency.",
  "signal_wiki_url": "https://www.sigidwiki.com/wiki/Emergency_Alert_System_(EAS)",
  "sample_path": "samples/sigidwiki/EAS_Alert_Tornado_Warning.mp3",
  "environments": [
    "node",
    "browser"
  ],
  "blocks": {
    "src": {
      "type": "Source",
      "placement": "node",
      "params": {
        "sample_rate_hz": 2400000.0,
        "bandwidth_hz": 2000000.0
      }
    },
    "chan": {
      "type": "Channelizer",
      "placement": "node",
      "params": {
        "input_rate_hz": 2400000.0,
        "output_rate_hz": 50000.0
      }
    },
    "tee": {
      "type": "TeeIqF32",
      "placement": "node"
    },
    "fft": {
      "type": "FFT",
      "placement": "node",
      "params": {
        "size": 16384,
        "window": "hann",
        "max_frames_per_second": 30
      }
    },
    "logmag": {
      "type": "LogMagU8",
      "placement": "node",
      "params": {
        "size": 16384,
        "alpha": 0.3
      }
    },
    "demod": {
      "type": "FmDemod",
      "placement": "node",
      "params": {
        "sample_rate_hz": 50000,
        "max_deviation_hz": 5000
      }
    },
    "resamp": {
      "type": "RealF32Resamp",
      "placement": "node",
      "params": {
        "output_rate_hz": 22050.0,
        "stopband_db": 60.0
      }
    },
    "eas": {
      "type": "EasDemod",
      "placement": "node",
      "params": {
        "sample_rate_hz": 22050.0
      }
    }
  },
  "wires": [
    [
      "src.out",
      "tee.in"
    ],
    [
      "tee.out0",
      "chan.in"
    ],
    [
      "tee.out1",
      "fft.in"
    ],
    [
      "chan.out",
      "demod.in"
    ],
    [
      "fft.out",
      "logmag.in"
    ],
    [
      "logmag.out",
      "ui:fft"
    ],
    [
      "demod.out",
      "resamp.in"
    ],
    [
      "resamp.out",
      "eas.in"
    ]
  ]
}
