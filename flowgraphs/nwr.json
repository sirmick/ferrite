{
  "$schema": "https://ferrite.example/flowgraph-v1.json",
  "name": "nwr",
  "category": "Weather & alerts",
  "label": "NOAA Weather Radio + EAS (162.55 MHz)",
  "description": "NOAA Weather Radio with SAME/EAS alert decoding \u2014 seven 25 kHz NBFM channels, 162.400\u2013162.550 MHz.",
  "ai_notes": "NOAA Weather Radio + SAME / EAS header decode. 162.400\u2013162.550 MHz NBFM in 25 kHz steps (7 channels); default 162.550 MHz. Always-on EAS decoder so emergency alerts surface in `tail decoder --category eas`. US-only by frequency; equivalent services elsewhere may differ.",
  "signal_wiki_url": "https://www.sigidwiki.com/wiki/Emergency_Alert_System_(EAS)",
  "sample_path": "samples/sigidwiki/EAS_Alert_Tornado_Warning.mp3",
  "signal_wiki_image": "samples/sigidwiki/images/EAS_NFM.jpg",
  "environments": [
    "node",
    "browser"
  ],
  "blocks": {
    "src": {
      "type": "Source",
      "placement": "node",
      "params": {
        "sample_rate_hz": 2400000.0,
        "bandwidth_hz": 2000000.0
      }
    },
    "chan": {
      "type": "Channelizer",
      "placement": "node",
      "params": {
        "input_rate_hz": 2400000.0,
        "output_rate_hz": 25000.0
      }
    },
    "tee": {
      "type": "TeeIqF32",
      "placement": "node"
    },
    "fft": {
      "type": "FFT",
      "placement": "node",
      "params": {
        "size": 16384,
        "window": "hann",
        "max_frames_per_second": 30
      }
    },
    "logmag": {
      "type": "LogMagU8",
      "placement": "node",
      "params": {
        "size": 16384,
        "alpha": 0.3
      }
    },
    "demod": {
      "type": "FmDemod",
      "placement": "node",
      "params": {
        "sample_rate_hz": 25000,
        "max_deviation_hz": 5000
      }
    },
    "resamp": {
      "type": "RealF32Resamp",
      "placement": "node",
      "params": {
        "output_rate_hz": 22050.0,
        "stopband_db": 60.0
      }
    },
    "eas": {
      "type": "EasDemod",
      "placement": "node",
      "params": {
        "sample_rate_hz": 22050.0
      }
    },
    "audio_tee": {
      "type": "TeeRealF32",
      "placement": "node"
    },
    "audio_resamp": {
      "type": "RealF32Resamp",
      "placement": "browser",
      "when": {
        "audio": true
      },
      "params": {
        "output_rate_hz": 48000.0,
        "stopband_db": 60.0
      }
    },
    "audio_nr": {
      "type": "AudioNrMono",
      "placement": "browser",
      "when": {
        "audio": true
      },
      "params": {
        "sample_rate_hz": 48000.0,
        "blanker_enable": true,
        "blanker_threshold_db": 20.0,
        "blanker_hold_ms": 0.5,
        "neural_enable": true,
        "neural_attenuation_db": 18.0
      }
    },
    "audio": {
      "type": "AudioSink",
      "placement": "browser",
      "when": {
        "audio": true
      },
      "params": {
        "buffer_samples": 8192
      }
    }
  },
  "wires": [
    [
      "src.out",
      "tee.in"
    ],
    [
      "tee.out0",
      "chan.in"
    ],
    [
      "tee.out1",
      "fft.in"
    ],
    [
      "chan.out",
      "demod.in"
    ],
    [
      "demod.out",
      "audio_tee.in"
    ],
    [
      "audio_tee.out0",
      "resamp.in"
    ],
    [
      "fft.out",
      "logmag.in"
    ],
    [
      "logmag.out",
      "ui:fft"
    ],
    [
      "resamp.out",
      "eas.in"
    ],
    [
      "audio_tee.out1",
      "audio_resamp.in"
    ],
    [
      "audio_resamp.out",
      "audio_nr.in"
    ],
    [
      "audio_nr.out",
      "audio.in"
    ]
  ]
}
