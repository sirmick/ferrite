{
  "$schema": "https://ferrite.example/flowgraph-v1.json",
  "name": "wbfm_stereo",
  "label": "FM broadcast (stereo)",
  "description": "Wideband FM broadcast with stereo decoding — same 87.9–107.9 MHz band as the mono preset, but recovers the L/R channels from the 38 kHz subcarrier when the 19 kHz pilot is detected. Falls back gracefully to L+R sum if the station isn't transmitting in stereo.",
  "environments": [
    "node",
    "browser"
  ],
  "blocks": {
    "src": {
      "type": "Source",
      "placement": "node",
      "params": {
        "center_freq_hz": 100100000.0,
        "sample_rate_hz": 2400000.0,
        "bandwidth_hz": 2000000.0
      }
    },
    "chan": {
      "type": "Channelizer",
      "placement": "node",
      "params": {
        "input_rate_hz": 2400000.0,
        "freq_shift_hz": 0.0,
        "output_rate_hz": 240000.0
      }
    },
    "tee": {
      "type": "TeeIqF32",
      "placement": "node"
    },
    "fft": {
      "type": "FFT",
      "placement": "node",
      "params": {
        "size": 16384,
        "window": "hann",
        "max_frames_per_second": 30
      }
    },
    "logmag": {
      "type": "LogMagU8",
      "placement": "node",
      "params": {
        "size": 16384,
        "alpha": 0.3
      }
    },
    "demod": {
      "type": "FmDemod",
      "placement": "browser",
      "params": {
        "sample_rate_hz": 240000,
        "max_deviation_hz": 75000
      }
    },
    "stereo": {
      "type": "StereoDecoder",
      "placement": "browser",
      "params": {
        "sample_rate_hz": 240000,
        "lock_threshold": 0.02,
        "lock_tau_ms": 100,
        "emit_interval_ms": 100
      }
    },
    "decim_l": {
      "type": "RealF32Resamp",
      "placement": "browser",
      "params": {
        "output_rate_hz": 48000.0,
        "stopband_db": 60.0
      }
    },
    "decim_r": {
      "type": "RealF32Resamp",
      "placement": "browser",
      "params": {
        "output_rate_hz": 48000.0,
        "stopband_db": 60.0
      }
    },
    "audio_l": {
      "type": "AudioSink",
      "params": {
        "buffer_samples": 8192
      }
    },
    "audio_r": {
      "type": "AudioSink",
      "params": {
        "buffer_samples": 8192
      }
    },
    "deemph_l": {
      "type": "FmDeEmphasis",
      "placement": "browser",
      "params": {
        "tau_us": 75.0
      }
    },
    "deemph_r": {
      "type": "FmDeEmphasis",
      "placement": "browser",
      "params": {
        "tau_us": 75.0
      }
    }
  },
  "wires": [
    [
      "src.out",
      "tee.in"
    ],
    [
      "tee.out0",
      "chan.in"
    ],
    [
      "tee.out1",
      "fft.in"
    ],
    [
      "chan.out",
      "demod.in"
    ],
    [
      "fft.out",
      "logmag.in"
    ],
    [
      "logmag.out",
      "ui:fft"
    ],
    [
      "demod.out",
      "stereo.in"
    ],
    [
      "stereo.left",
      "deemph_l.in"
    ],
    [
      "stereo.right",
      "deemph_r.in"
    ],
    [
      "decim_l.out",
      "audio_l.in"
    ],
    [
      "decim_r.out",
      "audio_r.in"
    ],
    [
      "deemph_l.out",
      "decim_l.in"
    ],
    [
      "deemph_r.out",
      "decim_r.in"
    ]
  ]
}
