{
  "$schema": "https://ferrite.example/flowgraph-v1.json",
  "name": "wbfm_stereo",
  "category": "FM/AM broadcast",
  "label": "FM broadcast (stereo)",
  "description": "Wideband FM broadcast, 87.9\u2013107.9 MHz, with pilot-locked stereo decoding (mono fallback).",
  "ai_notes": "Wideband FM broadcast, pilot-decoded stereo. Falls back to mono when the 19 kHz pilot is below `lock_threshold`; the events port carries stereo-lock status. If asked \"why is this mono?\" check pilot amplitude before retuning.",
  "signal_wiki_url": "https://www.sigidwiki.com/wiki/FM_Broadcast_Radio",
  "sample_path": "samples/sigidwiki/WFM.mp3",
  "signal_wiki_image": "samples/sigidwiki/images/Stereo_left_right_fmbroadcast.jpg",
  "environments": [
    "node",
    "browser"
  ],
  "blocks": {
    "src": {
      "type": "Source",
      "placement": "node",
      "params": {
        "sample_rate_hz": 2400000.0,
        "bandwidth_hz": 2000000.0
      }
    },
    "chan": {
      "type": "Channelizer",
      "placement": "node",
      "params": {
        "input_rate_hz": 2400000.0,
        "output_rate_hz": 240000.0
      }
    },
    "tee": {
      "type": "TeeIqF32",
      "placement": "node"
    },
    "fft": {
      "type": "FFT",
      "placement": "node",
      "params": {
        "size": 16384,
        "window": "hann",
        "max_frames_per_second": 30
      }
    },
    "logmag": {
      "type": "LogMagU8",
      "placement": "node",
      "params": {
        "size": 16384,
        "alpha": 0.3
      }
    },
    "chan_tee": {
      "type": "TeeIqF32",
      "placement": "node"
    },
    "demod_rds": {
      "type": "FmDemod",
      "placement": "node",
      "params": {
        "sample_rate_hz": 240000,
        "max_deviation_hz": 75000
      }
    },
    "rds": {
      "type": "RdsDemod",
      "placement": "node",
      "params": {
        "sample_rate_hz": 240000.0
      }
    },
    "demod": {
      "type": "FmDemod",
      "placement": "browser",
      "params": {
        "sample_rate_hz": 240000,
        "max_deviation_hz": 75000
      }
    },
    "stereo": {
      "type": "StereoDecoder",
      "placement": "browser",
      "params": {
        "sample_rate_hz": 240000,
        "lock_threshold": 0.02,
        "lock_tau_ms": 100,
        "emit_interval_ms": 100
      }
    },
    "decim_l": {
      "type": "RealF32Resamp",
      "placement_role": "audio",
      "placement": "browser",
      "params": {
        "output_rate_hz": 48000.0,
        "stopband_db": 60.0
      }
    },
    "decim_r": {
      "type": "RealF32Resamp",
      "placement_role": "audio",
      "placement": "browser",
      "params": {
        "output_rate_hz": 48000.0,
        "stopband_db": 60.0
      }
    },
    "audio_nr": {
      "type": "AudioNrStereo",
      "placement_role": "nr",
      "placement": "browser",
      "params": {
        "sample_rate_hz": 48000.0,
        "deemph_enable": true,
        "deemph_tau_us": 75.0
      }
    },
    "audio_l": {
      "type": "AudioSink",
      "placement": "browser",
      "params": {
        "buffer_samples": 8192
      }
    },
    "audio_r": {
      "type": "AudioSink",
      "placement": "browser",
      "params": {
        "buffer_samples": 8192
      }
    }
  },
  "wires": [
    [
      "src.out",
      "tee.in"
    ],
    [
      "tee.out0",
      "chan.in"
    ],
    [
      "tee.out1",
      "fft.in"
    ],
    [
      "chan.out",
      "chan_tee.in"
    ],
    [
      "chan_tee.out0",
      "demod.in"
    ],
    [
      "chan_tee.out1",
      "demod_rds.in"
    ],
    [
      "demod_rds.out",
      "rds.in"
    ],
    [
      "rds.events",
      "ui:rds"
    ],
    [
      "fft.out",
      "logmag.in"
    ],
    [
      "logmag.out",
      "ui:fft"
    ],
    [
      "demod.out",
      "stereo.in"
    ],
    [
      "stereo.left",
      "decim_l.in"
    ],
    [
      "stereo.right",
      "decim_r.in"
    ],
    [
      "decim_l.out",
      "audio_nr.left"
    ],
    [
      "decim_r.out",
      "audio_nr.right"
    ],
    [
      "audio_nr.left",
      "audio_l.in"
    ],
    [
      "audio_nr.right",
      "audio_r.in"
    ]
  ]
}
