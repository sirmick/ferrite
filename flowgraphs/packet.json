{
  "$schema": "https://ferrite.example/flowgraph-v1.json",
  "name": "packet",
  "category": "Packet / APRS",
  "label": "Packet radio (APRS / AX.25)",
  "description": "AX.25 packet radio \u2014 APRS and BBS/satellite traffic; AFSK1200, AFSK2400 and FSK9600 decoded in parallel.",
  "ai_notes": "AX.25 packet decoder. Most common use is APRS on 144.39 MHz (NA), 144.800 MHz (EU), 145.175 MHz (AU), but anything AX.25-framed at AFSK1200 / AFSK2400 / FSK9600 (e.g. legacy BBS, AMSAT digipeaters) decodes here too. Five multimon decoders run in parallel so the user doesn't need to pick a PHY variant manually. Output: `tail decoder --category packet`. For diagnostic side-by-side with a WAV recording see `packet-debug`.",
  "signal_wiki_url": "https://www.sigidwiki.com/wiki/Automatic_Packet_Reporting_System_(APRS)",
  "sample_path": "samples/sigidwiki/AFSK1200_Sound.mp3",
  "signal_wiki_image": "samples/sigidwiki/images/AFSK1200_Waterfall.png",
  "environments": [
    "node",
    "browser"
  ],
  "blocks": {
    "src": {
      "type": "Source",
      "placement": "node",
      "params": {
        "sample_rate_hz": 2400000.0,
        "bandwidth_hz": 2000000.0
      }
    },
    "chan": {
      "type": "Channelizer",
      "placement": "node",
      "params": {
        "input_rate_hz": 2400000.0,
        "output_rate_hz": 25000.0
      }
    },
    "tee": {
      "type": "TeeIqF32",
      "placement": "node"
    },
    "fft": {
      "type": "FFT",
      "placement": "node",
      "params": {
        "size": 16384,
        "window": "hann",
        "max_frames_per_second": 30
      }
    },
    "logmag": {
      "type": "LogMagU8",
      "placement": "node",
      "params": {
        "size": 16384,
        "alpha": 0.3
      }
    },
    "demod": {
      "type": "FmDemod",
      "placement": "node",
      "params": {
        "sample_rate_hz": 25000,
        "max_deviation_hz": 3000
      }
    },
    "audio_tee": {
      "type": "TeeRealF32",
      "placement": "node"
    },
    "resamp": {
      "type": "RealF32Resamp",
      "placement": "node",
      "params": {
        "output_rate_hz": 22050.0,
        "stopband_db": 60.0
      }
    },
    "packet": {
      "type": "PacketDemod",
      "placement": "node",
      "params": {
        "sample_rate_hz": 22050.0
      }
    },
    "audio_resamp": {
      "type": "RealF32Resamp",
      "placement": "browser",
      "when": {
        "audio": true
      },
      "params": {
        "output_rate_hz": 48000.0,
        "stopband_db": 60.0
      }
    },
    "audio": {
      "type": "AudioSink",
      "placement": "browser",
      "when": {
        "audio": true
      },
      "params": {
        "buffer_samples": 8192
      }
    }
  },
  "wires": [
    [
      "src.out",
      "tee.in"
    ],
    [
      "tee.out0",
      "chan.in"
    ],
    [
      "tee.out1",
      "fft.in"
    ],
    [
      "chan.out",
      "demod.in"
    ],
    [
      "fft.out",
      "logmag.in"
    ],
    [
      "logmag.out",
      "ui:fft"
    ],
    [
      "demod.out",
      "audio_tee.in"
    ],
    [
      "audio_tee.out0",
      "resamp.in"
    ],
    [
      "resamp.out",
      "packet.in"
    ],
    [
      "packet.events",
      "ui:aprs"
    ],
    [
      "audio_tee.out1",
      "audio_resamp.in"
    ],
    [
      "audio_resamp.out",
      "audio.in"
    ]
  ]
}
