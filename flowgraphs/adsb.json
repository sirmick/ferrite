{
  "$schema": "https://ferrite.example/flowgraph-v1.json",
  "name": "adsb",
  "category": "Aviation",
  "label": "ADS-B / Mode S",
  "description": "Aircraft Mode S / ADS-B transponder messages on 1090 MHz (dump1090 decoder).",
  "ai_notes": "ADS-B / Mode-S aircraft transponders on 1090 MHz. Vendored dump1090; locked at 2 MS/s. Best with a vertical antenna on a roof or window \u2014 line-of-sight to airliners is what matters, not antenna gain. Output: `tail decoder --category adsb`. Most decodes will be DF17 extended squitters with positions + IDs.",
  "signal_wiki_url": "https://www.sigidwiki.com/wiki/Automatic_Dependent_Surveillance-Broadcast_(ADS-B)",
  "signal_wiki_image": "samples/sigidwiki/images/ADS-BTHMB.jpg",
  "sample_path": "samples/uhf/adsb_1090mhz_iq-f32-2ms.iq",
  "environments": [
    "node",
    "browser"
  ],
  "blocks": {
    "src": {
      "type": "Source",
      "placement": "node",
      "params": {
        "sample_rate_hz": 2000000.0,
        "bandwidth_hz": 2000000.0
      }
    },
    "tee": {
      "type": "TeeIqF32",
      "placement": "node"
    },
    "chan": {
      "type": "Channelizer",
      "placement": "node",
      "params": {
        "input_rate_hz": 2000000.0,
        "output_rate_hz": 2000000.0
      }
    },
    "fft": {
      "type": "FFT",
      "placement": "node",
      "params": {
        "size": 16384,
        "window": "hann",
        "max_frames_per_second": 30
      }
    },
    "logmag": {
      "type": "LogMagU8",
      "placement": "node",
      "params": {
        "size": 16384,
        "alpha": 0.3
      }
    },
    "adsb": {
      "type": "AdsbDemod",
      "placement": "node",
      "params": {
        "sample_rate_hz": 2000000.0
      }
    }
  },
  "wires": [
    [
      "src.out",
      "tee.in"
    ],
    [
      "tee.out0",
      "chan.in"
    ],
    [
      "tee.out1",
      "fft.in"
    ],
    [
      "chan.out",
      "adsb.in"
    ],
    [
      "fft.out",
      "logmag.in"
    ],
    [
      "logmag.out",
      "ui:fft"
    ],
    [
      "adsb.events",
      "ui:adsb"
    ]
  ]
}
