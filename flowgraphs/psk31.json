{
  "$schema": "https://ferrite.example/flowgraph-v1.json",
  "name": "psk31",
  "category": "HF digital modes",
  "label": "PSK",
  "description": "PSK31 \u2014 the most popular HF keyboard mode: 31-baud BPSK in ~60 Hz, big results on tiny power.",
  "ai_notes": "PSK31 (BPSK 31.25 baud Varicode, vendored fldigi psk core). Watering holes (USB dial): 3.580 / 7.070 / 14.070 / 21.070 / 28.120 MHz \u2014 tune dial \u2248 centre \u2212 1500 Hz so the sub-band lands on the 1500 Hz PSK sweetspot; click into individual signals on the waterfall. Output: `tail decoder --category fldigi`. Bursty QSO traffic, not a beacon \u2014 wait for activity. psk63/psk125 modes also available via the Psk31Demod `mode` param.",
  "signal_wiki_url": "https://www.sigidwiki.com/wiki/PSK31",
  "sample_path": "samples/sigidwiki/BPSK31.mp3",
  "signal_wiki_image": "samples/sigidwiki/images/PSK31.jpg",
  "environments": [
    "node",
    "browser"
  ],
  "variants": [
    {
      "id": "31",
      "label": "PSK31",
      "default": true,
      "patch": {}
    },
    {
      "id": "63",
      "label": "PSK63",
      "patch": {
        "psk": {
          "baud": 63
        }
      }
    },
    {
      "id": "125",
      "label": "PSK125",
      "patch": {
        "psk": {
          "baud": 125
        }
      }
    }
  ],
  "blocks": {
    "src": {
      "type": "Source",
      "placement": "node",
      "params": {
        "center_freq_hz": 14068500.0,
        "sample_rate_hz": 2400000.0,
        "bandwidth_hz": 2000000.0
      }
    },
    "tee": {
      "type": "TeeIqF32",
      "placement": "node"
    },
    "chan": {
      "type": "Channelizer",
      "placement": "node",
      "params": {
        "input_rate_hz": 2400000.0,
        "output_rate_hz": 8000.0
      }
    },
    "fft": {
      "type": "FFT",
      "placement": "node",
      "params": {
        "size": 16384,
        "window": "hann",
        "max_frames_per_second": 30
      }
    },
    "logmag": {
      "type": "LogMagU8",
      "placement": "node",
      "params": {
        "size": 16384,
        "alpha": 0.3
      }
    },
    "demod": {
      "type": "SsbDemod",
      "placement": "node",
      "params": {
        "sample_rate_hz": 8000,
        "sideband": "usb",
        "audio_gain": 30.0
      }
    },
    "audio_tee": {
      "type": "TeeRealF32",
      "placement": "node"
    },
    "psk": {
      "type": "Psk31Demod",
      "placement": "node",
      "params": {
        "afc": true
      }
    },
    "audio_resamp": {
      "type": "RealF32Resamp",
      "placement_role": "audio",
      "placement": "browser",
      "when": {
        "audio": true
      },
      "params": {
        "output_rate_hz": 48000.0,
        "stopband_db": 60.0
      }
    },
    "audio_nr": {
      "type": "AudioNrMono",
      "placement_role": "nr",
      "placement": "browser",
      "when": {
        "audio": true
      },
      "params": {
        "sample_rate_hz": 48000.0,
        "neural_enable": false,
        "notch_enable": false,
        "neural_attenuation_db": 18.0
      }
    },
    "audio": {
      "type": "AudioSink",
      "placement": "browser",
      "when": {
        "audio": true
      },
      "params": {
        "buffer_samples": 8192
      }
    }
  },
  "wires": [
    [
      "src.out",
      "tee.in"
    ],
    [
      "tee.out0",
      "chan.in"
    ],
    [
      "tee.out1",
      "fft.in"
    ],
    [
      "chan.out",
      "demod.in"
    ],
    [
      "demod.out",
      "audio_tee.in"
    ],
    [
      "audio_tee.out0",
      "psk.in"
    ],
    [
      "audio_tee.out1",
      "audio_resamp.in"
    ],
    [
      "audio_resamp.out",
      "audio_nr.in"
    ],
    [
      "audio_nr.out",
      "audio.in"
    ],
    [
      "fft.out",
      "logmag.in"
    ],
    [
      "psk.events",
      "ui:fldigi"
    ],
    [
      "logmag.out",
      "ui:fft"
    ]
  ]
}
