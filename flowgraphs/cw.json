{
  "$schema": "https://ferrite.example/flowgraph-v1.json",
  "name": "cw",
  "label": "CW / Morse decode (HF)",
  "description": "Auto-decode Morse on HF CW bands. Default tuning is 14.030 MHz USB (20 m CW), but the band-plan ribbon makes it easy to retune anywhere CW lives — 7.030 (40 m), 10.115 (30 m), 21.030 (15 m), 28.030 (10 m). Tune so the CW tone sits around 600–800 Hz in the audio (use the VFO Nixie); multimon's Goertzel detector locks onto whatever clean tone it sees and emits decoded characters into the Logs tab under `decoder::cw`. Pair with the `usb` preset on the same frequency to listen while decoding.",
  "signal_wiki_url": "https://www.sigidwiki.com/wiki/Morse_Code_(CW)",
  "sample_path": "samples/sigidwiki/Cw_morse.mp3",
  "environments": [
    "node",
    "browser"
  ],
  "blocks": {
    "src": {
      "type": "Source",
      "placement": "node",
      "params": {
        "center_freq_hz": 14030000.0,
        "sample_rate_hz": 2400000.0,
        "bandwidth_hz": 2000000.0
      }
    },
    "chan": {
      "type": "Channelizer",
      "placement": "node",
      "params": {
        "input_rate_hz": 2400000.0,
        "freq_shift_hz": 0.0,
        "output_rate_hz": 48000.0
      }
    },
    "tee": {
      "type": "TeeIqF32",
      "placement": "node"
    },
    "fft": {
      "type": "FFT",
      "placement": "node",
      "params": {
        "size": 16384,
        "window": "hann",
        "max_frames_per_second": 30
      }
    },
    "logmag": {
      "type": "LogMagU8",
      "placement": "node",
      "params": {
        "size": 16384,
        "alpha": 0.3
      }
    },
    "demod": {
      "type": "SsbDemod",
      "placement": "node",
      "params": {
        "sample_rate_hz": 48000,
        "sideband": "usb",
        "audio_gain": 30.0
      }
    },
    "resamp": {
      "type": "RealF32Resamp",
      "placement": "node",
      "params": {
        "output_rate_hz": 22050.0,
        "stopband_db": 60.0
      }
    },
    "morse": {
      "type": "MorseDemod",
      "placement": "node",
      "params": {
        "sample_rate_hz": 22050.0
      }
    }
  },
  "wires": [
    [
      "src.out",
      "tee.in"
    ],
    [
      "tee.out0",
      "chan.in"
    ],
    [
      "tee.out1",
      "fft.in"
    ],
    [
      "chan.out",
      "demod.in"
    ],
    [
      "fft.out",
      "logmag.in"
    ],
    [
      "logmag.out",
      "ui:fft"
    ],
    [
      "demod.out",
      "resamp.in"
    ],
    [
      "resamp.out",
      "morse.in"
    ]
  ]
}
