{
  "$schema": "https://ferrite.example/flowgraph-v1.json",
  "name": "cw",
  "label": "CW / Morse decode (HF)",
  "description": "Auto-decode Morse on HF CW bands (14.030 / 7.030 / 10.115 / 21.030 / 28.030 MHz). Tune so the CW tone sits at 600\u2013800 Hz in audio.",
  "ai_notes": "Morse / CW decoder for HF ham bands. Standard calling frequencies: 14.030 / 7.030 / 10.115 / 21.030 / 28.030 MHz. Tune so the CW tone sits at 600\u2013800 Hz audio (USB demod, dial freq slightly below the carrier). The auto-WPM detector handles ~5\u201340 wpm. Output: `tail decoder --category cw`.",
  "signal_wiki_url": "https://www.sigidwiki.com/wiki/Morse_Code_(CW)",
  "sample_path": "samples/sigidwiki/Cw_morse.mp3",
  "signal_wiki_image": "samples/sigidwiki/images/CW.jpg",
  "environments": ["node", "browser"],
  "blocks": {
    "src": {
      "type": "Source",
      "placement": "node",
      "params": {
        "sample_rate_hz": 2400000.0,
        "bandwidth_hz": 2000000.0
      }
    },
    "chan": {
      "type": "Channelizer",
      "placement": "node",
      "params": {
        "input_rate_hz": 2400000.0,
        "output_rate_hz": 6000.0
      }
    },
    "tee": {
      "type": "TeeIqF32",
      "placement": "node"
    },
    "fft": {
      "type": "FFT",
      "placement": "node",
      "params": {
        "size": 16384,
        "window": "hann",
        "max_frames_per_second": 30
      }
    },
    "logmag": {
      "type": "LogMagU8",
      "placement": "node",
      "params": {
        "size": 16384,
        "alpha": 0.3
      }
    },
    "demod": {
      "type": "SsbDemod",
      "placement": "node",
      "params": {
        "sample_rate_hz": 6000,
        "sideband": "usb",
        "audio_gain": 30.0
      }
    },
    "resamp": {
      "type": "RealF32Resamp",
      "placement": "node",
      "params": {
        "output_rate_hz": 22050.0,
        "stopband_db": 60.0
      }
    },
    "morse": {
      "type": "MorseDemod",
      "placement": "node",
      "params": {
        "sample_rate_hz": 22050.0
      }
    }
  },
  "wires": [
    ["src.out", "tee.in"],
    ["tee.out0", "chan.in"],
    ["tee.out1", "fft.in"],
    ["chan.out", "demod.in"],
    ["fft.out", "logmag.in"],
    ["logmag.out", "ui:fft"],
    ["demod.out", "resamp.in"],
    ["resamp.out", "morse.in"]
  ]
}
