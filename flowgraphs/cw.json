{
  "$schema": "https://ferrite.example/flowgraph-v1.json",
  "name": "cw",
  "category": "HF digital modes",
  "label": "CW / Morse decode (HF)",
  "description": "Auto-decoded Morse on the HF CW calling frequencies (3.5\u201328 MHz).",
  "ai_notes": "Morse / CW decoder for HF ham bands (fldigi's CW core: a narrow filter on the tone + speed tracking, one record per word in the `fldigi` kind / Journal view). CW lives in the bottom ~70 kHz of each band (20 m: 14.000\u201314.070; 40 m: 7.000\u20137.060; 30 m: 10.100\u201310.130); NCDXF beacons on 14.100 / 18.110 / 21.150 / 24.930 / 28.200 in 10-s slots. The tone must land within \u00b1bandwidth/2 of `cw.rx_freq_hz` (700 Hz): find the exact carrier with `spectrum <lo> <hi>` (few-Hz resolution) and park with `tune --carrier <f>` (it reads the tone from this block). AFC is off on purpose \u2014 headless fldigi can't search and drifts onto noise between overs. For fast contest CW raise `cw.wpm` (tracking spans \u00b1`wpm_range`). Use AGC off + fixed gain on HF.",
  "signal_wiki_url": "https://www.sigidwiki.com/wiki/Morse_Code_(CW)",
  "sample_path": "samples/sigidwiki/Cw_morse.mp3",
  "signal_wiki_image": "samples/sigidwiki/images/CW.jpg",
  "environments": [
    "node",
    "browser"
  ],
  "blocks": {
    "src": {
      "type": "Source",
      "placement": "node",
      "params": {
        "sample_rate_hz": 2400000.0,
        "bandwidth_hz": 2000000.0
      }
    },
    "chan": {
      "type": "Channelizer",
      "placement": "node",
      "params": {
        "input_rate_hz": 2400000.0,
        "output_rate_hz": 6000.0
      }
    },
    "tee": {
      "type": "TeeIqF32",
      "placement": "node"
    },
    "fft": {
      "type": "FFT",
      "placement": "node",
      "params": {
        "size": 16384,
        "window": "hann",
        "max_frames_per_second": 30
      }
    },
    "logmag": {
      "type": "LogMagU8",
      "placement": "node",
      "params": {
        "size": 16384,
        "alpha": 0.3
      }
    },
    "demod": {
      "type": "SsbDemod",
      "placement": "node",
      "params": {
        "sample_rate_hz": 6000,
        "sideband": "usb",
        "audio_gain": 30.0
      }
    },
    "resamp": {
      "type": "RealF32Resamp",
      "placement_role": "audio",
      "placement": "node",
      "params": {
        "output_rate_hz": 8000.0,
        "stopband_db": 60.0
      }
    },
    "audio_tee": {
      "type": "TeeRealF32",
      "placement": "node"
    },
    "audio_resamp": {
      "type": "RealF32Resamp",
      "placement_role": "audio",
      "placement": "browser",
      "when": {
        "audio": true
      },
      "params": {
        "output_rate_hz": 48000.0,
        "stopband_db": 60.0
      }
    },
    "audio_nr": {
      "type": "AudioNrMono",
      "placement_role": "nr",
      "placement": "browser",
      "when": {
        "audio": true
      },
      "params": {
        "sample_rate_hz": 48000.0,
        "blanker_enable": true,
        "blanker_threshold_db": 18.0,
        "blanker_hold_ms": 0.5
      }
    },
    "audio": {
      "type": "AudioSink",
      "placement": "browser",
      "when": {
        "audio": true
      },
      "params": {
        "buffer_samples": 8192
      }
    },
    "cw": {
      "type": "CwDemod",
      "params": {
        "afc": false,
        "rx_freq_hz": 700,
        "wpm": 20,
        "wpm_range": 15,
        "bandwidth_hz": 150
      }
    }
  },
  "wires": [
    [
      "src.out",
      "tee.in"
    ],
    [
      "tee.out0",
      "chan.in"
    ],
    [
      "tee.out1",
      "fft.in"
    ],
    [
      "chan.out",
      "demod.in"
    ],
    [
      "demod.out",
      "audio_tee.in"
    ],
    [
      "audio_tee.out0",
      "resamp.in"
    ],
    [
      "fft.out",
      "logmag.in"
    ],
    [
      "logmag.out",
      "ui:fft"
    ],
    [
      "audio_tee.out1",
      "audio_resamp.in"
    ],
    [
      "audio_resamp.out",
      "audio_nr.in"
    ],
    [
      "audio_nr.out",
      "audio.in"
    ],
    [
      "resamp.out",
      "cw.in"
    ],
    [
      "cw.events",
      "ui:fldigi"
    ]
  ]
}
