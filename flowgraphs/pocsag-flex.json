{
  "$schema": "https://ferrite.example/flowgraph-v1.json",
  "name": "pocsag-flex",
  "label": "POCSAG / FLEX pagers",
  "description": "Pager messages on the 929-932 MHz US carrier band — runs POCSAG (512/1200/2400 bps) and FLEX (1600/3200/6400 bps 4-FSK) decoders in parallel on the same audio. Most US carriers migrated from POCSAG to FLEX in the 2000s; in many metros the busy carriers are now FLEX (hospital alerts, sensor monitoring, fleet pages). Default frequency 929.6125 MHz lands on a typical pager pool. Decoded messages stream into the Logs tab under the `decoder::pocsag` and `decoder::flex` categories — mute one independently from the categories dropdown.",
  "environments": [
    "node",
    "browser"
  ],
  "blocks": {
    "src": {
      "type": "Source",
      "placement": "node",
      "params": {
        "center_freq_hz": 929612500.0,
        "sample_rate_hz": 2400000.0,
        "bandwidth_hz": 2000000.0
      }
    },
    "chan": {
      "type": "Channelizer",
      "placement": "node",
      "params": {
        "input_rate_hz": 2400000.0,
        "freq_shift_hz": 0.0,
        "output_rate_hz": 50000.0
      }
    },
    "tee": {
      "type": "TeeIqF32",
      "placement": "node"
    },
    "fft": {
      "type": "FFT",
      "placement": "node",
      "params": {
        "size": 16384,
        "window": "hann",
        "max_frames_per_second": 30
      }
    },
    "logmag": {
      "type": "LogMagU8",
      "placement": "node",
      "params": {
        "size": 16384,
        "alpha": 0.3
      }
    },
    "demod": {
      "type": "FmDemod",
      "placement": "node",
      "params": {
        "sample_rate_hz": 50000,
        "max_deviation_hz": 5000
      }
    },
    "resamp": {
      "type": "RealF32Resamp",
      "placement": "node",
      "params": {
        "output_rate_hz": 22050.0,
        "stopband_db": 60.0
      }
    },
    "pocsag": {
      "type": "PocsagDemod",
      "placement": "node",
      "params": {
        "sample_rate_hz": 22050.0
      }
    }
  },
  "wires": [
    [
      "src.out",
      "tee.in"
    ],
    [
      "tee.out0",
      "chan.in"
    ],
    [
      "tee.out1",
      "fft.in"
    ],
    [
      "chan.out",
      "demod.in"
    ],
    [
      "fft.out",
      "logmag.in"
    ],
    [
      "logmag.out",
      "ui:fft"
    ],
    [
      "demod.out",
      "resamp.in"
    ],
    [
      "resamp.out",
      "pocsag.in"
    ]
  ]
}
