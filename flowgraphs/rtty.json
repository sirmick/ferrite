{
  "$schema": "https://ferrite.example/flowgraph-v1.json",
  "name": "rtty",
  "category": "HF digital modes",
  "label": "RTTY",
  "description": "RTTY \u2014 the classic HF radioteletype keyboard mode: Baudot 2-tone FSK, amateur standard 45.45 baud / 170 Hz.",
  "ai_notes": "RTTY (Baudot radioteletype, vendored fldigi core). Default rtty45 = 170 Hz shift / 45.45 baud / 5-bit Baudot \u2014 the amateur standard. Tune dial \u2248 signal \u2212 1500 Hz so the pair lands on fldigi's 1500 Hz sweetspot; AFC tracks. Amateur watering holes (USB): 3.590 / 7.090 / 14.085 / 21.090 / 28.090 MHz. Output: `tail decoder --category fldigi`. Weak/noisy copy is often the antenna/AGC, not the decoder \u2014 fixed gain + AGC off helps on quiet bands. Output is continuous (no slots): wait for a transmission, RTTY is bursty QSO/contest traffic.",
  "signal_wiki_url": "https://www.sigidwiki.com/wiki/RTTY",
  "sample_path": "samples/sigidwiki/RTTY_170Hz_45.45bd.mp3",
  "signal_wiki_image": "samples/sigidwiki/images/RTTY_170Hz_45.45bd.jpg",
  "environments": [
    "node",
    "browser"
  ],
  "variants": [
    {
      "id": "45-170",
      "label": "45.45 / 170 (amateur)",
      "default": true,
      "patch": {}
    },
    {
      "id": "50-170",
      "label": "50 / 170",
      "patch": {
        "rtty": {
          "baud": 50,
          "shift": 170
        }
      }
    },
    {
      "id": "75-170",
      "label": "75 / 170",
      "patch": {
        "rtty": {
          "baud": 75,
          "shift": 170
        }
      }
    },
    {
      "id": "100-170",
      "label": "100 / 170",
      "patch": {
        "rtty": {
          "baud": 100,
          "shift": 170
        }
      }
    },
    {
      "id": "45-425",
      "label": "45.45 / 425 (commercial)",
      "patch": {
        "rtty": {
          "baud": 45.45,
          "shift": 425
        }
      }
    },
    {
      "id": "75-850",
      "label": "75 / 850 (commercial)",
      "patch": {
        "rtty": {
          "baud": 75,
          "shift": 850
        }
      }
    }
  ],
  "blocks": {
    "src": {
      "type": "Source",
      "placement": "node",
      "params": {
        "center_freq_hz": 14083500.0,
        "sample_rate_hz": 2400000.0,
        "bandwidth_hz": 2000000.0
      }
    },
    "tee": {
      "type": "TeeIqF32",
      "placement": "node"
    },
    "chan": {
      "type": "Channelizer",
      "placement": "node",
      "params": {
        "input_rate_hz": 2400000.0,
        "output_rate_hz": 8000.0
      }
    },
    "fft": {
      "type": "FFT",
      "placement": "node",
      "params": {
        "size": 16384,
        "window": "hann",
        "max_frames_per_second": 30
      }
    },
    "logmag": {
      "type": "LogMagU8",
      "placement": "node",
      "params": {
        "size": 16384,
        "alpha": 0.3
      }
    },
    "demod": {
      "type": "SsbDemod",
      "placement": "node",
      "params": {
        "sample_rate_hz": 8000,
        "sideband": "usb",
        "audio_gain": 30.0
      }
    },
    "audio_tee": {
      "type": "TeeRealF32",
      "placement": "node"
    },
    "rtty": {
      "type": "RttyDemod",
      "placement": "node",
      "params": {
        "afc": true
      }
    },
    "audio_resamp": {
      "type": "RealF32Resamp",
      "placement_role": "audio",
      "placement": "browser",
      "when": {
        "audio": true
      },
      "params": {
        "output_rate_hz": 48000.0,
        "stopband_db": 60.0
      }
    },
    "audio_nr": {
      "type": "AudioNrMono",
      "placement_role": "nr",
      "placement": "browser",
      "when": {
        "audio": true
      },
      "params": {
        "sample_rate_hz": 48000.0,
        "neural_enable": false,
        "notch_enable": false,
        "neural_attenuation_db": 18.0
      }
    },
    "audio": {
      "type": "AudioSink",
      "placement": "browser",
      "when": {
        "audio": true
      },
      "params": {
        "buffer_samples": 8192
      }
    }
  },
  "wires": [
    [
      "src.out",
      "tee.in"
    ],
    [
      "tee.out0",
      "chan.in"
    ],
    [
      "tee.out1",
      "fft.in"
    ],
    [
      "chan.out",
      "demod.in"
    ],
    [
      "demod.out",
      "audio_tee.in"
    ],
    [
      "audio_tee.out0",
      "rtty.in"
    ],
    [
      "audio_tee.out1",
      "audio_resamp.in"
    ],
    [
      "audio_resamp.out",
      "audio_nr.in"
    ],
    [
      "audio_nr.out",
      "audio.in"
    ],
    [
      "fft.out",
      "logmag.in"
    ],
    [
      "rtty.events",
      "ui:fldigi"
    ],
    [
      "logmag.out",
      "ui:fft"
    ]
  ]
}
