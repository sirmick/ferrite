{
  "$schema": "https://ferrite.example/flowgraph-v1.json",
  "name": "nbfm",
  "label": "Narrowband FM (voice)",
  "description": "Narrowband FM voice — 25 kHz channels: NOAA weather radio, marine VHF, public safety, FRS/GMRS, 2 m and 70 cm amateur. ±5 kHz deviation. Pick a frequency from the Bands tab to land on a known channel.",
  "environments": [
    "node",
    "browser"
  ],
  "blocks": {
    "src": {
      "type": "Source",
      "placement": "node",
      "params": {
        "center_freq_hz": 162400000.0,
        "sample_rate_hz": 2400000.0,
        "bandwidth_hz": 2000000.0
      }
    },
    "chan": {
      "type": "Channelizer",
      "placement": "node",
      "params": {
        "input_rate_hz": 2400000.0,
        "freq_shift_hz": 0.0,
        "output_rate_hz": 50000.0
      }
    },
    "tee": {
      "type": "TeeIqF32",
      "placement": "node"
    },
    "fft": {
      "type": "FFT",
      "placement": "node",
      "params": {
        "size": 16384,
        "window": "hann",
        "max_frames_per_second": 30
      }
    },
    "logmag": {
      "type": "LogMagU8",
      "placement": "node",
      "params": {
        "size": 16384,
        "alpha": 0.3
      }
    },
    "demod": {
      "type": "FmDemod",
      "placement": "browser",
      "params": {
        "sample_rate_hz": 48000,
        "max_deviation_hz": 5000
      }
    },
    "audio": {
      "type": "AudioSink",
      "params": {
        "buffer_samples": 8192
      }
    },
    "resamp": {
      "type": "RealF32Resamp",
      "placement": "browser",
      "params": {
        "output_rate_hz": 48000.0,
        "stopband_db": 60.0
      }
    },
    "audio_nr": {
      "type": "AudioNrMono",
      "placement": "browser",
      "params": {
        "sample_rate_hz": 48000.0,
        "blanker_enable": true,
        "blanker_threshold_db": 20.0,
        "blanker_hold_ms": 0.5,
        "neural_enable": true,
        "neural_attenuation_db": 18.0
      }
    }
  },
  "wires": [
    [
      "src.out",
      "tee.in"
    ],
    [
      "tee.out0",
      "chan.in"
    ],
    [
      "tee.out1",
      "fft.in"
    ],
    [
      "chan.out",
      "demod.in"
    ],
    [
      "fft.out",
      "logmag.in"
    ],
    [
      "logmag.out",
      "ui:fft"
    ],
    [
      "demod.out",
      "resamp.in"
    ],
    [
      "resamp.out",
      "audio_nr.in"
    ],
    [
      "audio_nr.out",
      "audio.in"
    ]
  ]
}
