{
  "$schema": "https://ferrite.example/flowgraph-v1.json",
  "name": "nbfm",
  "label": "Narrowband FM (voice)",
  "description": "Narrowband FM voice \u2014 25 kHz channels: NOAA weather, marine VHF, public-safety, FRS/GMRS, 2 m / 70 cm amateur. \u00b15 kHz deviation.",
  "ai_notes": "Narrowband FM voice, 25 kHz channels: 2 m / 70 cm repeaters, marine VHF (156-162 MHz), public-safety, FRS/GMRS (462-467 MHz). +-5 kHz deviation. Squelch, 3.4 kHz voice LPF, 75 us de-emphasis, impulse blanker. `neural`/`spectral` selectable in the UI for weak/hissy channels.",
  "signal_wiki_url": "https://www.sigidwiki.com/wiki/NFM_Voice",
  "sample_path": "samples/sigidwiki/Nfm_voice.mp3",
  "signal_wiki_image": "samples/sigidwiki/images/Sintitulo.png",
  "environments": ["node", "browser"],
  "blocks": {
    "src": {
      "type": "Source",
      "placement": "node",
      "params": {
        "sample_rate_hz": 2400000.0,
        "bandwidth_hz": 2000000.0
      }
    },
    "chan": {
      "type": "Channelizer",
      "placement": "node",
      "params": {
        "input_rate_hz": 2400000.0,
        "output_rate_hz": 25000.0
      }
    },
    "squelch": {
      "type": "Squelch",
      "placement": "node",
      "params": {
        "sample_rate_hz": 25000.0,
        "threshold_db": -50.0,
        "hysteresis_db": 3.0,
        "fade_tau_ms": 20.0
      }
    },
    "tee": {
      "type": "TeeIqF32",
      "placement": "node"
    },
    "fft": {
      "type": "FFT",
      "placement": "node",
      "params": {
        "size": 16384,
        "window": "hann",
        "max_frames_per_second": 30
      }
    },
    "logmag": {
      "type": "LogMagU8",
      "placement": "node",
      "params": {
        "size": 16384,
        "alpha": 0.3
      }
    },
    "demod": {
      "type": "FmDemod",
      "placement": "browser",
      "placement_role": "demod",
      "params": {
        "sample_rate_hz": 25000,
        "max_deviation_hz": 5000
      }
    },
    "audio": {
      "type": "AudioSink",
      "placement": "browser",
      "when": { "audio": true },
      "params": {
        "buffer_samples": 8192
      }
    },
    "shaper": {
      "type": "AudioShaper",
      "placement": "browser",
      "when": { "audio": true },
      "params": {
        "sample_rate_hz": 25000.0,
        "lpf_hz": 3400.0,
        "dc_block": true
      }
    },
    "resamp": {
      "type": "RealF32Resamp",
      "placement": "browser",
      "when": { "audio": true },
      "params": {
        "output_rate_hz": 48000.0,
        "stopband_db": 60.0
      }
    },
    "audio_nr": {
      "type": "AudioNrMono",
      "placement": "browser",
      "when": { "audio": true },
      "params": {
        "sample_rate_hz": 48000.0,
        "deemph_enable": true,
        "deemph_tau_us": 75.0,
        "blanker_enable": true,
        "blanker_threshold_db": 20.0,
        "blanker_hold_ms": 0.5
      }
    }
  },
  "wires": [
    ["src.out", "tee.in"],
    ["tee.out0", "chan.in"],
    ["tee.out1", "fft.in"],
    ["chan.out", "squelch.in"],
    ["squelch.out", "demod.in"],
    ["fft.out", "logmag.in"],
    ["logmag.out", "ui:fft"],
    ["demod.out", "shaper.in"],
    ["shaper.out", "resamp.in"],
    ["resamp.out", "audio_nr.in"],
    ["audio_nr.out", "audio.in"]
  ]
}
