{
  "$schema": "https://ferrite.example/flowgraph-v1.json",
  "name": "wbfm",
  "label": "FM broadcast (mono)",
  "description": "Wideband FM receiver — 5× IQ decimation to 48 kHz baseband, phase-discriminator demod, mono audio. Stereo pilot + L-R + RDS need wider baseband (future chain).",
  "environments": ["browser"],
  "blocks": {
    "src": {
      "type": "WsIqSource",
      "params": {
        "streamId": 2,
        "bufferFloats": 131072
      }
    },
    "decim": {
      "type": "Decimator",
      "params": {
        "factor": 5,
        "num_taps": 41,
        "cutoff_normalized": 0.08
      }
    },
    "demod": {
      "type": "FmDemod",
      "params": {
        "sample_rate_hz": 48000,
        "max_deviation_hz": 75000
      }
    },
    "audio": {
      "type": "AudioSink",
      "params": {
        "bufferSamples": 8192
      }
    }
  },
  "wires": [
    ["src.out", "decim.in"],
    ["decim.out", "demod.in"],
    ["demod.out", "audio.in"]
  ]
}
