{
  "$schema": "https://ferrite.example/flowgraph-v1.json",
  "name": "wbfm",
  "label": "WBFM broadcast",
  "description": "Wideband FM broadcast demodulator — drains a VFO stream, phase-discriminates, decimates to 48 kS/s, feeds the browser AudioSink.",
  "environments": ["browser"],
  "blocks": {
    "src": {
      "type": "WsIqSource",
      "params": {
        "streamId": 2,
        "bufferFloats": 131072
      }
    },
    "demod": {
      "type": "FmDemod",
      "params": {
        "sample_rate_hz": 240000,
        "max_deviation_hz": 75000
      }
    },
    "decim": {
      "type": "Decimator",
      "params": {
        "in_rate_hz": 240000,
        "out_rate_hz": 48000
      }
    },
    "audio": {
      "type": "AudioSink",
      "params": {
        "bufferSamples": 8192
      }
    }
  },
  "wires": [
    ["src.out", "demod.in"],
    ["demod.out", "decim.in"],
    ["decim.out", "audio.in"]
  ]
}
