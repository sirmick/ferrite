{
  "$schema": "https://ferrite.example/flowgraph-v1.json",
  "name": "wbfm",
  "label": "FM broadcast (mono)",
  "description": "Wideband FM receiver authored as one cross-env doc. The node half reads 2.4 MS/s IQ off an RTL-SDR (or any Soapy device with a matching `args` string) and a TeeIqF32 fans the raw source into two paths: a server-side FFT → LogMagU8 chain that terminates at the `ui:fft` sentinel (so the spectrum shows the full 2.4 MHz RF span like every mainstream SDR UI), and the audio chain where a Channelizer picks a 240 kS/s VFO to baseband, an FmDemod at channel rate discriminates the ±75 kHz deviation without aliasing, then a RealF32Decimator drops the real audio to 48 kHz for AudioSink playback. env_split inserts a WsBridgeTxFftU8 on the node side for `ui:fft`, and a WsBridgeTx/WsBridgeRx pair across the `chan.out → demod.in` environment boundary.",
  "environments": ["node", "browser"],
  "blocks": {
    "src": {
      "type": "Source",
      "placement": "node",
      "params": {
        "center_freq_hz": 100100000.0,
        "sample_rate_hz": 2400000.0,
        "bandwidth_hz": 2000000.0
      }
    },
    "chan": {
      "type": "Channelizer",
      "placement": "node",
      "params": {
        "input_rate_hz": 2400000.0,
        "freq_shift_hz": 0.0,
        "factor": 10,
        "num_taps": 81,
        "cutoff_normalized": 0.05
      }
    },
    "tee": {
      "type": "TeeIqF32",
      "placement": "node"
    },
    "fft": {
      "type": "FFT",
      "placement": "node",
      "params": {
        "size": 16384,
        "window": "hann"
      }
    },
    "logmag": {
      "type": "LogMagU8",
      "placement": "node",
      "params": {
        "size": 16384,
        "floor_dbfs": -100.0,
        "ceil_dbfs": 0.0,
        "alpha": 0.3
      }
    },
    "rssi": {
      "type": "RssiProbe",
      "placement": "node",
      "params": {
        "sample_rate_hz": 240000,
        "smooth_tau_ms": 50,
        "emit_interval_ms": 50
      }
    },
    "demod": {
      "type": "FmDemod",
      "placement": "browser",
      "params": {
        "sample_rate_hz": 240000,
        "max_deviation_hz": 75000
      }
    },
    "decim": {
      "type": "RealF32Decimator",
      "placement": "browser",
      "params": {
        "factor": 5,
        "num_taps": 41,
        "cutoff_normalized": 0.08
      }
    },
    "audio": {
      "type": "AudioSink",
      "params": {
        "buffer_samples": 8192
      }
    }
  },
  "wires": [
    ["src.out", "tee.in"],
    ["tee.out0", "chan.in"],
    ["tee.out1", "fft.in"],
    ["chan.out", "rssi.in"],
    ["rssi.out", "demod.in"],
    ["rssi.events", "ui:rssi"],
    ["fft.out", "logmag.in"],
    ["logmag.out", "ui:fft"],
    ["demod.out", "decim.in"],
    ["decim.out", "audio.in"]
  ]
}
