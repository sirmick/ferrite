{
  "$schema": "https://ferrite.example/flowgraph-v1.json",
  "name": "wbfm",
  "label": "FM broadcast (mono)",
  "description": "Wideband FM broadcast — commercial radio, 87.9–107.9 MHz. Mono playback; pick the stereo preset if you want pilot-locked L/R.",
  "signal_wiki_url": "https://www.sigidwiki.com/wiki/FM_Broadcast_Radio",
  "sample_path": "samples/sigidwiki/WFM.mp3",
  "signal_wiki_image": "samples/sigidwiki/images/Broadcast_FM.jpg",
  "environments": [
    "node",
    "browser"
  ],
  "blocks": {
    "src": {
      "type": "Source",
      "placement": "node",
      "params": {
        "sample_rate_hz": 2400000.0,
        "bandwidth_hz": 2000000.0
      }
    },
    "chan": {
      "type": "Channelizer",
      "placement": "node",
      "params": {
        "input_rate_hz": 2400000.0,
        "output_rate_hz": 240000.0
      }
    },
    "tee": {
      "type": "TeeIqF32",
      "placement": "node"
    },
    "fft": {
      "type": "FFT",
      "placement": "node",
      "params": {
        "size": 16384,
        "window": "hann",
        "max_frames_per_second": 30
      }
    },
    "logmag": {
      "type": "LogMagU8",
      "placement": "node",
      "params": {
        "size": 16384,
        "floor_dbfs": -100.0,
        "ceil_dbfs": 0.0,
        "alpha": 0.3
      }
    },
    "rssi": {
      "type": "RssiProbe",
      "placement": "node",
      "params": {
        "sample_rate_hz": 240000,
        "smooth_tau_ms": 50,
        "emit_interval_ms": 50
      }
    },
    "chan_tee": {
      "type": "TeeIqF32",
      "placement": "node"
    },
    "demod_rds": {
      "type": "FmDemod",
      "placement": "node",
      "params": {
        "sample_rate_hz": 240000,
        "max_deviation_hz": 75000
      }
    },
    "rds": {
      "type": "RdsDemod",
      "placement": "node",
      "params": {
        "sample_rate_hz": 240000.0
      }
    },
    "demod": {
      "type": "FmDemod",
      "placement": "browser",
      "params": {
        "sample_rate_hz": 240000,
        "max_deviation_hz": 75000
      }
    },
    "decim": {
      "type": "RealF32Resamp",
      "placement": "browser",
      "params": {
        "output_rate_hz": 48000.0,
        "stopband_db": 60.0
      }
    },
    "audio_nr": {
      "type": "AudioNrMono",
      "placement": "browser",
      "params": {
        "sample_rate_hz": 48000.0,
        "deemph_enable": true,
        "deemph_tau_us": 75.0,
        "neural_enable": true,
        "neural_attenuation_db": 18.0
      }
    },
    "audio": {
      "type": "AudioSink",
      "params": {
        "buffer_samples": 8192
      }
    }
  },
  "wires": [
    [
      "src.out",
      "tee.in"
    ],
    [
      "tee.out0",
      "chan.in"
    ],
    [
      "tee.out1",
      "fft.in"
    ],
    [
      "chan.out",
      "chan_tee.in"
    ],
    [
      "chan_tee.out0",
      "rssi.in"
    ],
    [
      "chan_tee.out1",
      "demod_rds.in"
    ],
    [
      "demod_rds.out",
      "rds.in"
    ],
    [
      "rds.events",
      "ui:rds"
    ],
    [
      "rssi.out",
      "demod.in"
    ],
    [
      "rssi.events",
      "ui:rssi"
    ],
    [
      "fft.out",
      "logmag.in"
    ],
    [
      "logmag.out",
      "ui:fft"
    ],
    [
      "demod.out",
      "decim.in"
    ],
    [
      "decim.out",
      "audio_nr.in"
    ],
    [
      "audio_nr.out",
      "audio.in"
    ]
  ]
}
