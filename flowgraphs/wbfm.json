{
  "$schema": "https://ferrite.example/flowgraph-v1.json",
  "name": "wbfm",
  "label": "FM broadcast (mono)",
  "description": "Wideband FM broadcast \u2014 commercial radio, 87.9\u2013107.9 MHz. Mono playback; pick the stereo preset if you want pilot-locked L/R.",
  "ai_notes": "Wideband FM broadcast, mono. Pick for commercial radio (87.9\u2013107.9 MHz). Includes RdsDemod \u2014 RDS station name + program type show in the UI RdsReadout. Audio chain: 15 kHz LPF, 75 \u00b5s de-emphasis. `wbfm_stereo` for pilot-locked stereo.",
  "signal_wiki_url": "https://www.sigidwiki.com/wiki/FM_Broadcast_Radio",
  "sample_path": "samples/sigidwiki/WFM.mp3",
  "signal_wiki_image": "samples/sigidwiki/images/Broadcast_FM.jpg",
  "environments": ["node", "browser"],
  "blocks": {
    "src": {
      "type": "Source",
      "placement": "node",
      "params": {
        "sample_rate_hz": 2400000.0,
        "bandwidth_hz": 2000000.0
      }
    },
    "chan": {
      "type": "Channelizer",
      "placement": "node",
      "params": {
        "input_rate_hz": 2400000.0,
        "output_rate_hz": 240000.0
      }
    },
    "tee": {
      "type": "TeeIqF32",
      "placement": "node"
    },
    "fft": {
      "type": "FFT",
      "placement": "node",
      "params": {
        "size": 16384,
        "window": "hann",
        "max_frames_per_second": 30
      }
    },
    "logmag": {
      "type": "LogMagU8",
      "placement": "node",
      "params": {
        "size": 16384,
        "floor_dbfs": -100.0,
        "ceil_dbfs": 0.0,
        "alpha": 0.3
      }
    },
    "rssi": {
      "type": "RssiProbe",
      "placement": "node",
      "params": {
        "sample_rate_hz": 240000,
        "smooth_tau_ms": 50,
        "emit_interval_ms": 50
      }
    },
    "demod": {
      "type": "FmDemod",
      "placement": "node",
      "params": {
        "sample_rate_hz": 240000,
        "max_deviation_hz": 75000
      }
    },
    "audio_tee": {
      "type": "TeeRealF32",
      "placement": "node"
    },
    "rds": {
      "type": "RdsDemod",
      "placement": "node",
      "params": {
        "sample_rate_hz": 240000.0
      }
    },
    "shaper": {
      "type": "AudioShaper",
      "placement": "node",
      "when": { "audio": true },
      "params": {
        "sample_rate_hz": 240000.0,
        "lpf_hz": 15000.0,
        "dc_block": true
      }
    },
    "decim": {
      "type": "RealF32Resamp",
      "placement": "browser",
      "when": { "audio": true },
      "params": {
        "output_rate_hz": 48000.0,
        "stopband_db": 60.0
      }
    },
    "audio_nr": {
      "type": "AudioNrMono",
      "placement": "browser",
      "when": { "audio": true },
      "params": {
        "sample_rate_hz": 48000.0,
        "deemph_enable": true,
        "deemph_tau_us": 75.0
      }
    },
    "audio": {
      "type": "AudioSink",
      "placement": "browser",
      "when": { "audio": true },
      "params": {
        "buffer_samples": 8192
      }
    }
  },
  "wires": [
    ["src.out", "tee.in"],
    ["tee.out0", "chan.in"],
    ["tee.out1", "fft.in"],
    ["chan.out", "rssi.in"],
    ["rssi.out", "demod.in"],
    ["rssi.events", "ui:rssi"],
    ["demod.out", "audio_tee.in"],
    ["audio_tee.out0", "rds.in"],
    ["rds.events", "ui:rds"],
    ["fft.out", "logmag.in"],
    ["logmag.out", "ui:fft"],
    ["audio_tee.out1", "shaper.in"],
    ["shaper.out", "decim.in"],
    ["decim.out", "audio_nr.in"],
    ["audio_nr.out", "audio.in"]
  ]
}
