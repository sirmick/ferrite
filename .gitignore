# corpus — audio captures, screenshots, notes, vendor installers.
/samples/audio1/
/samples/uhf/
/notes
/notes/
/Screenshot*.png
/SDRplay_RSP_API-*.run

# Dev-server logs from `./run.sh` — regenerated on every start.
