{
  "typeName": "FmDemod",
  "placement": "either",
  "inputs": [{ "name": "in", "portType": "iq_f32" }],
  "outputs": [{ "name": "out", "portType": "real_f32" }],
  "params": [
    {
      "key": "sample_rate_hz",
      "label": "Input sample rate",
      "kind": {
        "kind": "range",
        "min": 1000.0,
        "max": 10000000.0,
        "step": 1.0,
        "default": 240000.0,
        "unit": "Hz"
      },
      "mutableWhileStreaming": false
    },
    {
      "key": "max_deviation_hz",
      "label": "Peak deviation",
      "kind": {
        "kind": "range",
        "min": 100.0,
        "max": 200000.0,
        "step": 100.0,
        "default": 75000.0,
        "unit": "Hz"
      },
      "mutableWhileStreaming": false
    }
  ]
}
